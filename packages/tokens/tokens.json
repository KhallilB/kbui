{
  "white": { "$type": "color", "$value": "#ffffff" },
  "black": { "$type": "color", "$value": "#000000" },
  "gray": {
    "50": { "$type": "color", "$value": "#fafafa" },
    "100": { "$type": "color", "$value": "#f4f4f5" },
    "200": { "$type": "color", "$value": "#e4e4e7" },
    "300": { "$type": "color", "$value": "#d4d4d8" },
    "400": { "$type": "color", "$value": "#a1a1aa" },
    "500": { "$type": "color", "$value": "#71717a" },
    "600": { "$type": "color", "$value": "#52525b" },
    "700": { "$type": "color", "$value": "#3f3f46" },
    "800": { "$type": "color", "$value": "#27272a" },
    "900": { "$type": "color", "$value": "#18181b" },
    "950": { "$type": "color", "$value": "#09090b" }
  },
  "blue": {
    "400": { "$type": "color", "$value": "#60a5fa" },
    "500": { "$type": "color", "$value": "#3b82f6" },
    "600": { "$type": "color", "$value": "#2563eb" },
    "700": { "$type": "color", "$value": "#1d4ed8" }
  },
  "red": {
    "400": { "$type": "color", "$value": "#f87171" },
    "500": { "$type": "color", "$value": "#ef4444" },
    "600": { "$type": "color", "$value": "#dc2626" }
  },
  "amber": {
    "400": { "$type": "color", "$value": "#fbbf24" },
    "500": { "$type": "color", "$value": "#f59e0b" },
    "600": { "$type": "color", "$value": "#d97706" },
    "700": { "$type": "color", "$value": "#b45309" }
  },
  "green": {
    "400": { "$type": "color", "$value": "#4ade80" },
    "500": { "$type": "color", "$value": "#22c55e" },
    "600": { "$type": "color", "$value": "#16a34a" },
    "700": { "$type": "color", "$value": "#15803d" }
  },
  "teal": {
    "400": { "$type": "color", "$value": "#2dd4bf" },
    "500": { "$type": "color", "$value": "#14b8a6" },
    "600": { "$type": "color", "$value": "#0d9488" },
    "700": { "$type": "color", "$value": "#0f766e" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.25rem" },
    "md": { "$type": "dimension", "$value": "0.5rem" },
    "lg": { "$type": "dimension", "$value": "0.75rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif" },
    "mono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, monospace" }
  },
  "size": {
    "xs": { "$type": "dimension", "$value": "0.75rem" },
    "sm": { "$type": "dimension", "$value": "0.875rem" },
    "md": { "$type": "dimension", "$value": "1rem" },
    "lg": { "$type": "dimension", "$value": "1.125rem" },
    "display": { "$type": "dimension", "$value": "2.25rem" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "80ms" },
      "base": { "$type": "duration", "$value": "160ms" },
      "slow": { "$type": "duration", "$value": "240ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "enter": { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "exit": { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },
  "color": {
    "bg": { "$type": "color", "$value": "{white}", "$extensions": { "kb.dark": "{gray.950}" } },
    "fg": { "$type": "color", "$value": "{gray.900}", "$extensions": { "kb.dark": "{gray.50}" } },
    "muted": {
      "$type": "color",
      "$value": "{gray.500}",
      "$extensions": { "kb.dark": "{gray.400}" }
    },
    "surface": {
      "$type": "color",
      "$value": "{gray.50}",
      "$extensions": { "kb.dark": "{gray.900}" }
    },
    "border": {
      "$type": "color",
      "$value": "{gray.200}",
      "$extensions": { "kb.dark": "{gray.800}" }
    },
    "accent": {
      "$type": "color",
      "$value": "{blue.600}",
      "$extensions": { "kb.dark": "{blue.500}" }
    },
    "accent-hover": {
      "$type": "color",
      "$value": "{blue.700}",
      "$extensions": { "kb.dark": "{blue.400}" }
    },
    "accent-fg": {
      "$type": "color",
      "$value": "{white}",
      "$extensions": { "kb.dark": "{gray.950}" }
    },
    "danger": {
      "$type": "color",
      "$value": "{red.600}",
      "$extensions": { "kb.dark": "{red.500}" }
    },
    "danger-hover": {
      "$type": "color",
      "$value": "{red.500}",
      "$extensions": { "kb.dark": "{red.400}" }
    },
    "danger-fg": {
      "$type": "color",
      "$value": "{white}",
      "$extensions": { "kb.dark": "{gray.950}" }
    },
    "info": {
      "$type": "color",
      "$value": "{teal.700}",
      "$extensions": { "kb.dark": "{teal.400}" }
    },
    "info-fg": {
      "$type": "color",
      "$value": "{white}",
      "$extensions": { "kb.dark": "{gray.950}" }
    },
    "success": {
      "$type": "color",
      "$value": "{green.700}",
      "$extensions": { "kb.dark": "{green.400}" }
    },
    "success-fg": {
      "$type": "color",
      "$value": "{white}",
      "$extensions": { "kb.dark": "{gray.950}" }
    },
    "warning": {
      "$type": "color",
      "$value": "{amber.700}",
      "$extensions": { "kb.dark": "{amber.400}" }
    },
    "warning-fg": {
      "$type": "color",
      "$value": "{white}",
      "$extensions": { "kb.dark": "{gray.950}" }
    },
    "ring": {
      "$type": "color",
      "$value": "{blue.500}",
      "$extensions": { "kb.dark": "{blue.400}" }
    },
    "overlay": {
      "$type": "color",
      "$value": "rgb(0 0 0 / 0.5)",
      "$extensions": { "kb.dark": "rgb(0 0 0 / 0.7)" }
    }
  },
  "card": {
    "background": { "$type": "color", "$value": "{color.bg}" },
    "color": { "$type": "color", "$value": "{color.fg}" },
    "border": { "$type": "color", "$value": "{color.border}" },
    "border-width": { "$type": "dimension", "$value": "1px" },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "padding": { "$type": "dimension", "$value": "{space.4}" }
  },
  "grid": {
    "gap": { "$type": "dimension", "$value": "{space.6}" },
    "min-item-width": { "$type": "dimension", "$value": "18.75rem" }
  },
  "button": {
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "motion-duration": { "$type": "duration", "$value": "120ms" },
    "motion-easing": { "$type": "string", "$value": "ease" },
    "press-offset": { "$type": "dimension", "$value": "0px" }
  },
  "input": {
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "height": {
      "sm": { "$type": "dimension", "$value": "2rem" },
      "md": { "$type": "dimension", "$value": "2.5rem" },
      "lg": { "$type": "dimension", "$value": "3rem" }
    }
  },
  "dialog": {
    "radius": { "$type": "dimension", "$value": "{radius.lg}" },
    "width": { "$type": "dimension", "$value": "28rem" },
    "background": { "$type": "color", "$value": "{color.bg}" },
    "color": { "$type": "color", "$value": "{color.fg}" },
    "border": { "$type": "color", "$value": "{color.border}" },
    "border-width": { "$type": "dimension", "$value": "1px" },
    "padding": { "$type": "dimension", "$value": "{space.6}" },
    "shadow": { "$type": "shadow", "$value": "{popup.shadow}" },
    "description-color": { "$type": "color", "$value": "{color.muted}" },
    "overlay-background": { "$type": "color", "$value": "{color.overlay}" },
    "motion-duration": { "$type": "duration", "$value": "150ms" },
    "motion-easing": { "$type": "string", "$value": "ease" },
    "enter-scale": { "$type": "number", "$value": "0.96" },
    "enter-offset": { "$type": "dimension", "$value": "0px" },
    "header-padding": { "$type": "string", "$value": "0px" },
    "body-padding": { "$type": "string", "$value": "0px" },
    "footer-padding": { "$type": "string", "$value": "0px" },
    "title-size": { "$type": "dimension", "$value": "{size.lg}" },
    "title-family": { "$type": "string", "$value": "inherit" },
    "title-weight": { "$type": "fontWeight", "$value": "600" }
  },
  "panel": {
    "background": { "$type": "color", "$value": "{color.surface}" },
    "background-active": {
      "$type": "color",
      "$value": "{color.bg}",
      "$extensions": { "kb.dark": "{gray.800}" }
    },
    "background-sunken": { "$type": "color", "$value": "{color.bg}" },
    "border": { "$type": "color", "$value": "{color.border}" },
    "border-active": {
      "$type": "color",
      "$value": "{color.accent}",
      "$extensions": { "kb.dark": "{blue.400}" }
    },
    "border-critical": {
      "$type": "color",
      "$value": "{color.danger}",
      "$extensions": { "kb.dark": "{red.400}" }
    },
    "rim-top": {
      "$type": "color",
      "$value": "{color.border}",
      "$extensions": { "kb.dark": "rgb(255 255 255 / 0.14)" }
    },
    "rim-bottom": {
      "$type": "color",
      "$value": "{color.border}",
      "$extensions": { "kb.dark": "rgb(255 255 255 / 0.04)" }
    },
    "seam": { "$type": "dimension", "$value": "1px" },
    "radius": { "$type": "dimension", "$value": "{radius.lg}" },
    "highlight": {
      "$type": "color",
      "$value": "rgb(255 255 255 / 0.9)",
      "$extensions": { "kb.dark": "rgb(255 255 255 / 0.08)" }
    },
    "divider": {
      "$type": "color",
      "$value": "{gray.200}",
      "$extensions": { "kb.dark": "rgb(255 255 255 / 0.06)" }
    },
    "sheen": { "$type": "color", "$value": "transparent" },
    "backdrop": { "$type": "string", "$value": "none" },
    "glow": { "$type": "color", "$value": "transparent" },
    "glow-active": { "$type": "color", "$value": "transparent" },
    "glow-critical": { "$type": "color", "$value": "transparent" },
    "glow-blur": { "$type": "dimension", "$value": "12px" },
    "shadow": {
      "$type": "shadow",
      "$value": "0 1px 2px rgb(0 0 0 / 0.06), 0 4px 12px -4px rgb(0 0 0 / 0.08)",
      "$extensions": { "kb.dark": "0 1px 2px rgb(0 0 0 / 0.6), 0 12px 32px -12px rgb(0 0 0 / 0.7)" }
    },
    "shadow-active": {
      "$type": "shadow",
      "$value": "0 1px 2px rgb(0 0 0 / 0.06), 0 8px 24px -12px rgb(0 0 0 / 0.18)",
      "$extensions": { "kb.dark": "0 1px 2px rgb(0 0 0 / 0.7), 0 32px 64px -24px rgb(0 0 0 / 0.9)" }
    },
    "well": {
      "$type": "color",
      "$value": "{gray.100}",
      "$extensions": { "kb.dark": "rgb(0 0 0 / 0.45)" }
    },
    "well-radius": { "$type": "dimension", "$value": "{radius.md}" },
    "well-shadow": {
      "$type": "shadow",
      "$value": "inset 0 1px 2px rgb(0 0 0 / 0.06), inset 0 0 0 1px rgb(0 0 0 / 0.06)",
      "$extensions": {
        "kb.dark": "inset 0 1px 3px rgb(0 0 0 / 0.6), inset 0 0 0 1px rgb(255 255 255 / 0.05)"
      }
    },
    "padding": { "$type": "dimension", "$value": "{space.4}" },
    "rail": { "$type": "color", "$value": "{color.border}" },
    "rail-active": { "$type": "color", "$value": "{color.accent}" }
  },
  "popup": {
    "motion-duration": { "$type": "duration", "$value": "{motion.duration.fast}" },
    "motion-easing": { "$type": "cubicBezier", "$value": "{motion.easing.standard}" },
    "background": {
      "$type": "color",
      "$value": "{color.bg}",
      "$extensions": { "kb.dark": "{gray.900}" }
    },
    "border": { "$type": "color", "$value": "{color.border}" },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "shadow": {
      "$type": "shadow",
      "$value": "0 1px 2px rgb(0 0 0 / 0.06), 0 8px 24px -8px rgb(0 0 0 / 0.16)",
      "$extensions": { "kb.dark": "0 1px 2px rgb(0 0 0 / 0.6), 0 16px 32px -12px rgb(0 0 0 / 0.8)" }
    }
  },
  "progress": {
    "track": { "$type": "color", "$value": "{color.border}" },
    "fill": { "$type": "color", "$value": "{color.accent}" },
    "fill-complete": { "$type": "color", "$value": "{color.success}" },
    "height": { "$type": "dimension", "$value": "{space.1}" },
    "glow": { "$type": "dimension", "$value": "0px" }
  },
  "stat": {
    "display-size": { "$type": "dimension", "$value": "{size.display}" },
    "display-weight": { "$type": "fontWeight", "$value": "500" }
  },
  "status": {
    "neutral": { "$type": "color", "$value": "{color.muted}" },
    "info": { "$type": "color", "$value": "{color.info}" },
    "running": { "$type": "color", "$value": "{color.accent}" },
    "success": { "$type": "color", "$value": "{color.success}" },
    "warning": { "$type": "color", "$value": "{color.warning}" },
    "blocked": { "$type": "color", "$value": "{color.danger}" },
    "radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "glow": { "$type": "dimension", "$value": "0px" }
  }
}
