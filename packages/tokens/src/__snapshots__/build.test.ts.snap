// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`buildTokens snapshot of css output 1`] = `
":where(:root) {
  --kb-blue-500: #2563eb;
  --kb-gray-950: #0a0a0a;
  --kb-white: #ffffff;
  --kb-space-4: 1rem;
  --kb-color-bg: var(--kb-white);
  --kb-color-accent: var(--kb-blue-500);
  --kb-button-radius: 0.5rem;
  color-scheme: light;
}

:where([data-theme="light"]) {
  --kb-color-bg: var(--kb-white);
  color-scheme: light;
}

:where([data-theme="dark"]) {
  --kb-color-bg: var(--kb-gray-950);
  color-scheme: dark;
}

@media (prefers-color-scheme: dark) {
  :where(:root:not([data-theme="light"])) {
    --kb-color-bg: var(--kb-gray-950);
    color-scheme: dark;
  }
}
"
`;

