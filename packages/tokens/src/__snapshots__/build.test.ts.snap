  --kb-motion-easing-standard: cubic-bezier(0.2, 0, 0, 1);
  --kb-motion-easing-enter: cubic-bezier(0, 0, 0.2, 1);
  --kb-motion-easing-exit: cubic-bezier(0.4, 0, 1, 1);
  --kb-color-bg: var(--kb-white);
  --kb-color-fg: var(--kb-gray-900);
  --kb-color-muted: var(--kb-gray-500);
