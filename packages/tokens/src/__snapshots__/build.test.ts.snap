  --kb-panel-border-critical: var(--kb-color-danger);
  --kb-panel-rim-top: var(--kb-material-raised-top);
  --kb-panel-rim-bottom: var(--kb-color-border);
  --kb-panel-divider: var(--kb-material-soft-border);
  --kb-panel-shadow: var(--kb-material-panel-shadow);
  --kb-panel-shadow-active: var(--kb-material-raised-shadow);
  --kb-panel-well: var(--kb-material-field-bg);
  --kb-panel-well-shadow: var(--kb-material-field-shadow);
  --kb-panel-rail: var(--kb-color-border);
  --kb-panel-rail-active: var(--kb-color-accent);
  --kb-popup-background: var(--kb-material-surface-bg);
  --kb-popup-border: var(--kb-color-border);
  --kb-popup-shadow: var(--kb-material-float-shadow);
  --kb-progress-track: var(--kb-material-recessed-face);
  --kb-progress-fill: var(--kb-color-accent);
  --kb-progress-fill-complete: var(--kb-color-success);
  --kb-status-neutral: var(--kb-color-muted);
  --kb-status-info: var(--kb-color-info);
  --kb-status-running: var(--kb-color-accent);
  --kb-status-success: var(--kb-color-success);
  --kb-status-warning: var(--kb-color-warning);
  --kb-status-blocked: var(--kb-color-danger);
  --kb-material-chrome-bg: #121418;
  --kb-material-chrome-fg: #f0f0f2;
  --kb-material-chrome-muted: #b5b7bf;
  --kb-material-field-bg: #191c22;
  --kb-material-control-border: #979ca7;
  --kb-material-soft-border: #3b404a;
  --kb-material-raised-top: #3c414b;
  --kb-material-raised-bottom: #292d35;
  --kb-material-raised-border: #979ca7;
  --kb-material-raised-shadow: inset 0 1px 0 rgb(255 255 255 / 0.24), inset 0 -1px 0 rgb(0 0 0 / 0.32), 0 1px 2px rgb(0 0 0 / 0.4), 0 3px 5px -2px rgb(0 0 0 / 0.65);
  --kb-material-pressed-shadow: inset 0 2px 3px rgb(0 0 0 / 0.5), inset 0 -1px 0 rgb(255 255 255 / 0.1);
  --kb-material-accent-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), inset 0 -1px 0 rgb(0 0 0 / 0.2), 0 1px 2px rgb(0 0 0 / 0.35), 0 3px 5px -2px rgb(0 0 0 / 0.45);
  --kb-material-panel-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), inset 0 -1px 0 rgb(0 0 0 / 0.22), 0 1px 2px rgb(0 0 0 / 0.35), 0 8px 24px -12px rgb(0 0 0 / 0.5);
  --kb-material-field-shadow: inset 0 2px 3px rgb(0 0 0 / 0.45), inset 0 -1px 0 rgb(255 255 255 / 0.1), 0 1px 0 rgb(255 255 255 / 0.07);
  --kb-material-inlay-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07), inset 0 -1px 0 rgb(0 0 0 / 0.15), 0 1px 1px rgb(0 0 0 / 0.18);
  --kb-material-float-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 2px 5px rgb(0 0 0 / 0.4), 0 24px 64px -16px rgb(0 0 0 / 0.65);
  --kb-material-raised-face: linear-gradient(180deg, var(--kb-material-raised-top), var(--kb-material-raised-bottom));
  --kb-material-recessed-face: linear-gradient(180deg, color-mix(in srgb, var(--kb-material-field-bg) 65%, var(--kb-material-chrome-bg)), var(--kb-material-field-bg));
  --kb-material-surface-bg: #24272e;
  --kb-switch-track-background: var(--kb-material-recessed-face);
  --kb-switch-track-border: var(--kb-material-raised-border);
  --kb-switch-track-shadow: var(--kb-material-field-shadow);
  --kb-switch-thumb-background: var(--kb-material-raised-face);
  --kb-switch-thumb-border: var(--kb-material-raised-border);
  --kb-switch-thumb-shadow: var(--kb-material-raised-shadow);
  color-scheme: dark;
}

@media (prefers-color-scheme: dark) {
  :where(:root:not([data-theme="light"])) {
    --kb-color-bg: #191b20;
    --kb-color-fg: #f0f0f2;
    --kb-color-muted: #b5b7bf;
    --kb-color-surface: #22252b;
    --kb-color-border: #505560;
    --kb-color-accent: #f2a184;
    --kb-color-accent-hover: #ffc0a6;
    --kb-color-accent-fg: #291a12;
    --kb-color-danger: #ff9f9f;
    --kb-color-danger-hover: #ffc6c6;
    --kb-color-danger-fg: #331c20;
    --kb-color-info: #a2c7eb;
    --kb-color-info-fg: var(--kb-gray-950);
    --kb-color-success: #a0d0a6;
    --kb-color-success-fg: var(--kb-gray-950);
    --kb-color-warning: #e5c477;
    --kb-color-warning-fg: var(--kb-gray-950);
    --kb-color-ring: #f2a184;
    --kb-color-overlay: rgb(0 0 0 / 0.7);
    --kb-card-background: var(--kb-material-surface-bg);
    --kb-card-color: var(--kb-color-fg);
    --kb-card-border: var(--kb-color-border);
    --kb-numberfield-background: var(--kb-color-bg);
    --kb-numberfield-color: var(--kb-color-fg);
    --kb-numberfield-border: var(--kb-color-border);
    --kb-dialog-background: var(--kb-material-surface-bg);
    --kb-dialog-color: var(--kb-color-fg);
    --kb-dialog-border: var(--kb-color-border);
    --kb-dialog-shadow: var(--kb-material-float-shadow);
    --kb-dialog-description-color: var(--kb-color-muted);
    --kb-dialog-overlay-background: var(--kb-color-overlay);
    --kb-panel-background: var(--kb-material-surface-bg);
    --kb-panel-background-active: var(--kb-material-surface-bg);
    --kb-panel-background-sunken: var(--kb-material-field-bg);
    --kb-panel-border: var(--kb-color-border);
    --kb-panel-border-active: var(--kb-color-accent);
    --kb-panel-border-critical: var(--kb-color-danger);
    --kb-panel-rim-top: var(--kb-material-raised-top);
    --kb-panel-rim-bottom: var(--kb-color-border);
    --kb-panel-divider: var(--kb-material-soft-border);
    --kb-panel-shadow: var(--kb-material-panel-shadow);
    --kb-panel-shadow-active: var(--kb-material-raised-shadow);
    --kb-panel-well: var(--kb-material-field-bg);
    --kb-panel-well-shadow: var(--kb-material-field-shadow);
    --kb-panel-rail: var(--kb-color-border);
    --kb-panel-rail-active: var(--kb-color-accent);
    --kb-popup-background: var(--kb-material-surface-bg);
    --kb-popup-border: var(--kb-color-border);
    --kb-popup-shadow: var(--kb-material-float-shadow);
    --kb-progress-track: var(--kb-material-recessed-face);
    --kb-progress-fill: var(--kb-color-accent);
    --kb-progress-fill-complete: var(--kb-color-success);
    --kb-status-neutral: var(--kb-color-muted);
    --kb-status-info: var(--kb-color-info);
    --kb-status-running: var(--kb-color-accent);
    --kb-status-success: var(--kb-color-success);
    --kb-status-warning: var(--kb-color-warning);
    --kb-status-blocked: var(--kb-color-danger);
    --kb-material-chrome-bg: #121418;
    --kb-material-chrome-fg: #f0f0f2;
    --kb-material-chrome-muted: #b5b7bf;
    --kb-material-field-bg: #191c22;
    --kb-material-control-border: #979ca7;
    --kb-material-soft-border: #3b404a;
    --kb-material-raised-top: #3c414b;
    --kb-material-raised-bottom: #292d35;
    --kb-material-raised-border: #979ca7;
    --kb-material-raised-shadow: inset 0 1px 0 rgb(255 255 255 / 0.24), inset 0 -1px 0 rgb(0 0 0 / 0.32), 0 1px 2px rgb(0 0 0 / 0.4), 0 3px 5px -2px rgb(0 0 0 / 0.65);
    --kb-material-pressed-shadow: inset 0 2px 3px rgb(0 0 0 / 0.5), inset 0 -1px 0 rgb(255 255 255 / 0.1);
    --kb-material-accent-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), inset 0 -1px 0 rgb(0 0 0 / 0.2), 0 1px 2px rgb(0 0 0 / 0.35), 0 3px 5px -2px rgb(0 0 0 / 0.45);
    --kb-material-panel-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), inset 0 -1px 0 rgb(0 0 0 / 0.22), 0 1px 2px rgb(0 0 0 / 0.35), 0 8px 24px -12px rgb(0 0 0 / 0.5);
    --kb-material-field-shadow: inset 0 2px 3px rgb(0 0 0 / 0.45), inset 0 -1px 0 rgb(255 255 255 / 0.1), 0 1px 0 rgb(255 255 255 / 0.07);
    --kb-material-inlay-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07), inset 0 -1px 0 rgb(0 0 0 / 0.15), 0 1px 1px rgb(0 0 0 / 0.18);
    --kb-material-float-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 2px 5px rgb(0 0 0 / 0.4), 0 24px 64px -16px rgb(0 0 0 / 0.65);
    --kb-material-raised-face: linear-gradient(180deg, var(--kb-material-raised-top), var(--kb-material-raised-bottom));
    --kb-material-recessed-face: linear-gradient(180deg, color-mix(in srgb, var(--kb-material-field-bg) 65%, var(--kb-material-chrome-bg)), var(--kb-material-field-bg));
    --kb-material-surface-bg: #24272e;
    --kb-switch-track-background: var(--kb-material-recessed-face);
    --kb-switch-track-border: var(--kb-material-raised-border);
    --kb-switch-track-shadow: var(--kb-material-field-shadow);
    --kb-switch-thumb-background: var(--kb-material-raised-face);
    --kb-switch-thumb-border: var(--kb-material-raised-border);
    --kb-switch-thumb-shadow: var(--kb-material-raised-shadow);
    color-scheme: dark;
  }
}
"
`;
