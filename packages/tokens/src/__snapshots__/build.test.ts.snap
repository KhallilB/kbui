  --kb-status-blocked: var(--kb-color-danger);
  --kb-material-chrome-bg: #242831;
  --kb-material-chrome-fg: #f5f6f8;
  --kb-material-chrome-muted: #c7cdd7;
  --kb-material-field-bg: #f8f9fb;
  --kb-material-control-border: #858e9d;
  --kb-material-soft-border: #e0e4eb;
  --kb-material-raised-top: #ffffff;
  --kb-material-raised-bottom: #e9edf3;
  --kb-material-raised-border: #858e9d;
  --kb-material-raised-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), inset 0 -1px 0 rgb(36 40 49 / 0.06), 0 1px 2px rgb(26 34 48 / 0.12), 0 3px 5px -3px rgb(26 34 48 / 0.12);
  --kb-material-pressed-shadow: inset 0 1px 3px rgb(36 40 49 / 0.16), inset 0 -1px 0 rgb(255 255 255 / 0.5);
  --kb-material-accent-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), inset 0 -1px 0 rgb(36 40 49 / 0.14), 0 1px 2px rgb(36 40 49 / 0.14), 0 3px 5px -2px rgb(36 40 49 / 0.18);
  --kb-material-panel-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), inset 0 -1px 0 rgb(36 40 49 / 0.035), 0 1px 2px rgb(26 34 48 / 0.12), 0 8px 24px -12px rgb(26 34 48 / 0.12);
  --kb-material-field-shadow: inset 0 1px 2px rgb(36 40 49 / 0.1), inset 0 -1px 0 rgb(255 255 255 / 0.9), 0 1px 0 rgb(255 255 255 / 0.75);
  --kb-material-inlay-shadow: inset 0 1px 0 rgb(255 255 255 / 0.65), inset 0 -1px 0 rgb(36 40 49 / 0.04), 0 1px 1px rgb(36 40 49 / 0.035);
  --kb-material-float-shadow: inset 0 1px 0 rgb(255 255 255 / 0.95), 0 2px 5px rgb(36 40 49 / 0.14), 0 24px 64px -16px rgb(36 40 49 / 0.32);
  --kb-material-raised-face: linear-gradient(180deg, var(--kb-material-raised-top), var(--kb-material-raised-bottom));
  --kb-material-recessed-face: linear-gradient(180deg, color-mix(in srgb, var(--kb-material-field-bg) 96%, var(--kb-color-fg)), var(--kb-material-field-bg));
  --kb-material-surface-bg: #ffffff;
  --kb-text-muted: var(--kb-color-muted);
  --kb-radiogroup-primary-background: var(--kb-color-action);
  --kb-radiogroup-primary-color: var(--kb-color-action-fg);
  --kb-switch-track-background: var(--kb-material-recessed-face);
  --kb-switch-track-border: var(--kb-material-raised-border);
  --kb-switch-track-shadow: var(--kb-material-field-shadow);
  --kb-switch-thumb-background: var(--kb-material-raised-face);
  --kb-switch-thumb-border: var(--kb-material-raised-border);
  --kb-switch-thumb-shadow: var(--kb-material-raised-shadow);
  --kb-link-color: var(--kb-color-accent-ink);
  --kb-link-hover: var(--kb-color-fg);
  --kb-code-background: var(--kb-color-surface);
  --kb-code-border: var(--kb-color-border);
  color-scheme: light;
}

:where([data-theme="dark"]) {
  --kb-color-bg: #17191d;
