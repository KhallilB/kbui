  --kb-panel-glow-critical: transparent;
  --kb-panel-glow-blur: 12px;
  --kb-panel-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 4px 12px -4px rgb(0 0 0 / 0.08);
  --kb-panel-shadow-active: 0 1px 2px rgb(0 0 0 / 0.06), 0 8px 24px -12px rgb(0 0 0 / 0.18);
  --kb-panel-well: var(--kb-gray-100);
