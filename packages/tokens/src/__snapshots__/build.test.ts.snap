    --kb-color-success: var(--kb-green-400);
    --kb-color-success-fg: var(--kb-gray-950);
    --kb-color-warning: var(--kb-amber-400);
    --kb-color-warning-fg: var(--kb-gray-950);
    --kb-color-ring: var(--kb-blue-400);
    --kb-color-overlay: rgb(0 0 0 / 0.7);
    --kb-panel-background-active: var(--kb-gray-800);
    --kb-panel-border-active: var(--kb-blue-400);
    --kb-panel-border-critical: var(--kb-red-400);
    --kb-panel-rim-top: rgb(255 255 255 / 0.14);
    --kb-panel-rim-bottom: rgb(255 255 255 / 0.04);
    --kb-panel-highlight: rgb(255 255 255 / 0.08);
    --kb-panel-divider: rgb(255 255 255 / 0.06);
    --kb-panel-shadow: 0 1px 2px rgb(0 0 0 / 0.6), 0 12px 32px -12px rgb(0 0 0 / 0.7);
    --kb-panel-shadow-active: 0 1px 2px rgb(0 0 0 / 0.7), 0 32px 64px -24px rgb(0 0 0 / 0.9);
    --kb-panel-well: rgb(0 0 0 / 0.45);
    --kb-panel-well-shadow: inset 0 1px 3px rgb(0 0 0 / 0.6), inset 0 0 0 1px rgb(255 255 255 / 0.05);
    --kb-popup-background: var(--kb-gray-900);
    --kb-popup-shadow: 0 1px 2px rgb(0 0 0 / 0.6), 0 16px 32px -12px rgb(0 0 0 / 0.8);
  }
