  --kb-color-ring: var(--kb-blue-500);
  --kb-color-overlay: rgb(0 0 0 / 0.5);
  --kb-button-radius: var(--kb-radius-md);
  --kb-input-radius: var(--kb-radius-md);
  --kb-input-height-sm: 2rem;
  --kb-input-height-md: 2.5rem;
  --kb-input-height-lg: 3rem;
  --kb-dialog-radius: var(--kb-radius-lg);
  --kb-dialog-width: 28rem;
  --kb-facet-background: var(--kb-color-surface);
  --kb-facet-background-active: var(--kb-color-bg);
