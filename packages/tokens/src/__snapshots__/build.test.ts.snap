@media (forced-colors: active) {
  :where(:root, [data-theme]) {
    --kb-viz-current: Highlight;
    --kb-viz-current-bg: Highlight;
    --kb-viz-current-fg: HighlightText;
    --kb-viz-visited: LinkText;
    --kb-viz-visited-bg: Canvas;
    --kb-viz-visited-fg: LinkText;
    --kb-viz-changed: CanvasText;
    --kb-viz-changed-bg: Mark;
    --kb-viz-changed-fg: MarkText;
    --kb-viz-error: CanvasText;
    --kb-viz-error-bg: Canvas;
    --kb-viz-error-fg: CanvasText;
    --kb-viz-discarded: GrayText;
