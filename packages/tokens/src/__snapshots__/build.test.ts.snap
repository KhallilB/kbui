  --kb-facet-border-critical: var(--kb-red-400);
  --kb-facet-cut-edge: rgb(255 255 255 / 0.16);
  --kb-facet-highlight: rgb(255 255 255 / 0.06);
  --kb-facet-divider: rgb(255 255 255 / 0.06);
  --kb-facet-shadow: drop-shadow(0 1px 1px rgb(0 0 0 / 0.7)) drop-shadow(0 8px 16px rgb(0 0 0 / 0.45));
  --kb-facet-shadow-active: drop-shadow(0 1px 2px rgb(0 0 0 / 0.8)) drop-shadow(0 16px 32px rgb(0 0 0 / 0.6));
