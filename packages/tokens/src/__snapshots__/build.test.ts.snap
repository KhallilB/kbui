  --kb-facet-well: var(--kb-gray-100);
  --kb-facet-well-shadow: inset 0 1px 2px rgb(0 0 0 / 0.06), inset 0 0 0 1px rgb(0 0 0 / 0.06);
  --kb-facet-padding: var(--kb-space-4);
  --kb-facet-rail: var(--kb-color-border);
