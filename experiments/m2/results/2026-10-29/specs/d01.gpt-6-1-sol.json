{
  "spec": {
    "root": "dashboard",
    "elements": {
      "dashboard": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "className": "mx-auto max-w-7xl p-6 lg:p-10 bg-slate-50 min-h-screen"
        },
        "children": [
          "header",
          "metrics",
          "details"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between",
          "gap": "lg"
        },
        "children": [
          "header-copy",
          "period"
        ]
      },
      "header-copy": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "eyebrow",
          "title",
          "subtitle"
        ]
      },
      "eyebrow": {
        "type": "Text",
        "props": {
          "text": "NORTHLINE / STORE ANALYTICS",
          "variant": "caption"
        },
        "children": []
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Sales overview",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Your store’s performance, at a glance.",
          "variant": "muted"
        },
        "children": []
      },
      "period": {
        "type": "Badge",
        "props": {
          "text": "September 1–30, 2026",
          "variant": "outline"
        },
        "children": []
      },
      "metrics": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"
        },
        "repeat": {
          "statePath": "/metrics",
          "key": "id"
        },
        "children": [
          "metric-card"
        ]
      },
      "metric-card": {
        "type": "Card",
        "props": {
          "className": "bg-white border-slate-200 shadow-sm"
        },
        "children": [
          "metric-content"
        ]
      },
      "metric-content": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "metric-label",
          "metric-value",
          "metric-comparison"
        ]
      },
      "metric-label": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "label"
          },
          "variant": "muted"
        },
        "children": []
      },
      "metric-value": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "value"
          },
          "level": "h2"
        },
        "children": []
      },
      "metric-comparison": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "metric-change",
          "metric-context"
        ]
      },
      "metric-change": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "change"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "metric-context": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "context"
          },
          "variant": "caption"
        },
        "children": []
      },
      "details": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "lg",
          "className": "grid-cols-1 lg:grid-cols-2"
        },
        "children": [
          "revenue-card",
          "products-card"
        ]
      },
      "revenue-card": {
        "type": "Card",
        "props": {
          "title": "Revenue breakdown",
          "description": "Sales by period · USD",
          "className": "bg-white border-slate-200 shadow-sm"
        },
        "children": [
          "revenue-content"
        ]
      },
      "revenue-content": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "children": [
          "revenue-summary",
          "revenue-periods",
          "revenue-note"
        ]
      },
      "revenue-summary": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center",
          "gap": "md"
        },
        "children": [
          "revenue-total",
          "revenue-growth"
        ]
      },
      "revenue-total": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/metrics/0/value"
          },
          "level": "h2"
        },
        "children": []
      },
      "revenue-growth": {
        "type": "Badge",
        "props": {
          "text": "+12.8% this month",
          "variant": "secondary"
        },
        "children": []
      },
      "revenue-periods": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "repeat": {
          "statePath": "/revenuePeriods",
          "key": "id"
        },
        "children": [
          "revenue-period"
        ]
      },
      "revenue-period": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "revenue-period-labels",
          "revenue-bar"
        ]
      },
      "revenue-period-labels": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center"
        },
        "children": [
          "revenue-period-date",
          "revenue-period-amount"
        ]
      },
      "revenue-period-date": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "label"
          },
          "variant": "muted"
        },
        "children": []
      },
      "revenue-period-amount": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "amount"
          }
        },
        "children": []
      },
      "revenue-bar": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "value"
          },
          "max": 15000,
          "label": {
            "$template": "${label}: ${amount}"
          }
        },
        "children": []
      },
      "revenue-note": {
        "type": "Text",
        "props": {
          "text": "Each bar uses a $15,000 scale. The final period includes two days.",
          "variant": "caption"
        },
        "children": []
      },
      "products-card": {
        "type": "Card",
        "props": {
          "title": "Top products",
          "description": "Ranked by revenue · September 2026",
          "className": "bg-white border-slate-200 shadow-sm"
        },
        "children": [
          "product-list",
          "products-note"
        ]
      },
      "product-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "repeat": {
          "statePath": "/products",
          "key": "id"
        },
        "children": [
          "product-row"
        ]
      },
      "product-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center",
          "justify": "between",
          "className": "border-b border-slate-100 pb-4"
        },
        "children": [
          "product-identity",
          "product-results"
        ]
      },
      "product-identity": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center"
        },
        "children": [
          "product-rank",
          "product-copy"
        ]
      },
      "product-rank": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "rank"
          },
          "variant": "outline"
        },
        "children": []
      },
      "product-copy": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "product-name",
          "product-category"
        ]
      },
      "product-name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          }
        },
        "children": []
      },
      "product-category": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "category"
          },
          "variant": "caption"
        },
        "children": []
      },
      "product-results": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm",
          "align": "end"
        },
        "children": [
          "product-revenue",
          "product-units"
        ]
      },
      "product-revenue": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "revenue"
          }
        },
        "children": []
      },
      "product-units": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${units} units sold"
          },
          "variant": "caption"
        },
        "children": []
      },
      "products-note": {
        "type": "Text",
        "props": {
          "text": "Revenue excludes shipping and taxes. Conversion rate is the share of sessions resulting in an order.",
          "variant": "caption"
        },
        "children": []
      }
