        "type": "Heading",
        "props": {
          "text": "Candidate pipeline",
          "level": "h2"
        },
        "children": []
      },
      "pipeline-description": {
        "type": "Text",
        "props": {
          "text": "Stage totals include all active candidates. Two upcoming candidate actions are highlighted per stage.",
          "variant": "muted"
        },
        "children": []
      },
      "stages": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "grid-cols-1 md:grid-cols-2 xl:grid-cols-4"
        },
        "repeat": {
          "statePath": "/stages",
          "key": "id"
        },
        "children": [
          "stage-card"
        ]
