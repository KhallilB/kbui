        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": {
            "$item": "candidates"
          },
          "key": "id"
        },
        "children": [
          "candidate"
        ]
      },
