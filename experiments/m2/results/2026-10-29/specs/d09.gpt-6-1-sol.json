        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm",
          "className": "rounded-lg border border-slate-100 p-3"
        },
        "children": [
          "candidate-identity",
          "candidate-role",
          "candidate-action"
        ]
      },
