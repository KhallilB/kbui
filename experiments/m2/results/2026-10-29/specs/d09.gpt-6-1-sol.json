          "text": {
            "$item": "month"
          }
        },
        "children": []
      },
      "month-days": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${days} days · ${hires} hires"
          },
          "variant": "caption"
        },
        "children": []
      },
      "month-bar": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "days"
          },
          "max": 45,
          "label": {
            "$template": "${month}: ${days} days out of a 45-day scale"
          }
        },
        "children": []
      },
      "speed-note": {
        "type": "Text",
        "props": {
