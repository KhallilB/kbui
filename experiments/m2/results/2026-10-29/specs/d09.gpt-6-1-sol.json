{
  "spec": {
    "root": "dashboard",
    "elements": {
      "dashboard": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "className": "mx-auto max-w-7xl p-8 bg-slate-50 min-h-screen"
        },
        "children": [
          "header",
          "metrics",
          "pipeline",
          "details"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center",
          "gap": "lg"
        },
        "children": [
          "header-copy",
          "period"
        ]
      },
      "header-copy": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "eyebrow",
          "title",
          "subtitle"
        ]
      },
      "eyebrow": {
        "type": "Text",
        "props": {
          "text": "PEOPLE OPERATIONS / RECRUITING",
          "variant": "caption"
        },
        "children": []
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Your next great team.",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "A clear view of your hiring pipeline, from first hello to signed offer.",
          "variant": "muted"
        },
        "children": []
      },
      "period": {
        "type": "Badge",
        "props": {
          "text": "October 2026 · Monthly overview",
          "variant": "outline"
        },
        "children": []
      },
      "metrics": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"
        },
        "repeat": {
          "statePath": "/metrics",
          "key": "id"
        },
        "children": [
          "metric-card"
        ]
      },
      "metric-card": {
        "type": "Card",
        "props": {
          "maxWidth": "full"
        },
        "children": [
          "metric-label",
          "metric-value",
          "metric-context"
        ]
      },
      "metric-label": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "label"
          },
          "variant": "muted"
        },
        "children": []
      },
      "metric-value": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "value"
          },
          "level": "h2"
        },
        "children": []
      },
      "metric-context": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "context"
          },
          "variant": "caption"
        },
        "children": []
      },
      "pipeline": {
        "type": "Stack",
        "props": {
