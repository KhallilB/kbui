        "type": "Heading",
        "props": {
          "text": {
            "$item": "name"
          },
          "level": "h3"
        },
        "children": []
      },
      "stage-count": {
        "type": "Badge",
        "props": {
          "text": {
            "$template": "${count} candidates"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "stage-note": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "note"
          },
          "variant": "caption"
        },
        "children": []
      },
      "stage-divider": {
        "type": "Separator",
        "props": {},
        "children": []
      },
