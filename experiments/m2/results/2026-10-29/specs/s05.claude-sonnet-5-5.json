{
  "spec": {
    "root": "main",
    "elements": {
      "main": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "children": [
          "header",
          "status-alert",
          "plan-card",
          "payment-card",
          "invoice-card",
          "danger-card",
          "change-dialog",
          "cancel-dialog",
          "payment-dialog"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Billing Settings",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Manage your plan, payment method and invoices.",
          "variant": "muted"
        },
        "children": []
      },
      "status-alert": {
        "type": "Alert",
        "props": {
          "title": "Your subscription will end on Nov 29, 2026",
          "message": "You've cancelled your plan. You'll keep access until the end of the billing period.",
          "type": "warning"
        },
        "visible": {
          "$state": "/planStatus",
          "eq": "cancelled"
        },
        "children": []
      },
      "plan-card": {
        "type": "Card",
        "props": {
          "title": "Current Plan",
          "description": "Your active subscription",
          "maxWidth": "full"
        },
        "children": [
          "plan-row",
          "plan-sep",
          "usage-stack",
          "plan-actions"
        ]
      },
      "plan-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "plan-info",
          "plan-price"
        ]
      },
      "plan-info": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "plan-name-row",
          "plan-renewal"
        ]
      },
      "plan-name-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "plan-name",
          "plan-badge"
        ]
      },
      "plan-name": {
        "type": "Heading",
        "props": {
          "text": {
            "$template": "${/selectedPlan} Plan"
          },
          "level": "h2"
        },
        "children": []
      },
      "plan-badge": {
        "type": "Badge",
        "props": {
          "text": {
            "$cond": {
              "$state": "/planStatus",
              "eq": "cancelled"
            },
            "$then": "Cancelling",
            "$else": "Active"
          },
          "variant": {
            "$cond": {
              "$state": "/planStatus",
              "eq": "cancelled"
            },
            "$then": "destructive",
            "$else": "default"
          }
        },
        "children": []
      },
      "plan-renewal": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "Billed ${/billingCycle}. Next billing date: Nov 29, 2026"
          },
          "variant": "muted"
        },
        "children": []
      },
      "plan-price": {
        "type": "Heading",
        "props": {
          "text": {
            "$cond": {
              "$state": "/billingCycle",
              "eq": "yearly"
            },
            "$then": "$190 / year",
            "$else": "$19 / month"
          },
          "level": "h2"
        },
        "children": []
      },
      "plan-sep": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "usage-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "usage-seats",
          "usage-storage"
        ]
      },
      "usage-seats": {
        "type": "Progress",
        "props": {
          "value": 60,
          "max": 100,
          "label": "Team seats: 6 of 10 used"
        },
        "children": []
      },
      "usage-storage": {
        "type": "Progress",
        "props": {
          "value": 42,
          "max": 100,
          "label": "Storage: 42 GB of 100 GB used"
        },
        "children": []
      },
      "plan-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm"
        },
        "children": [
          "change-btn"
        ]
      },
      "change-btn": {
        "type": "Button",
        "props": {
          "label": "Change Plan",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showChangePlan",
              "value": true
            }
          }
        },
        "children": []
      },
      "payment-card": {
        "type": "Card",
        "props": {
          "title": "Payment Method",
          "description": "The card used for your subscription",
          "maxWidth": "full"
        },
        "children": [
          "payment-row"
        ]
      },
      "payment-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "payment-info",
          "payment-btn"
        ]
      },
      "payment-info": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center"
        },
        "children": [
          "card-badge",
          "card-details"
        ]
      },
      "card-badge": {
        "type": "Badge",
        "props": {
          "text": "VISA",
          "variant": "outline"
        },
        "children": []
      },
      "card-details": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "none"
        },
        "children": [
          "card-number",
          "card-expiry"
        ]
      },
      "card-number": {
        "type": "Text",
        "props": {
          "text": "Visa ending in 4242",
          "variant": "body"
        },
        "children": []
      },
      "card-expiry": {
        "type": "Text",
        "props": {
          "text": "Expires 08/2028",
          "variant": "muted"
        },
        "children": []
      },
      "payment-btn": {
        "type": "Button",
        "props": {
          "label": "Update Card",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showPayment",
              "value": true
            }
          }
        },
        "children": []
      },
      "invoice-card": {
        "type": "Card",
        "props": {
          "title": "Invoice History",
          "description": "Download past invoices for your records",
          "maxWidth": "full"
        },
        "children": [
          "invoice-list"
        ]
      },
      "invoice-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "repeat": {
          "statePath": "/invoices",
          "key": "id"
        },
        "children": [
          "invoice-row"
        ]
      },
      "invoice-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "invoice-left",
          "invoice-right"
        ]
      },
      "invoice-left": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "none"
        },
        "children": [
          "invoice-number",
          "invoice-date"
        ]
      },
      "invoice-number": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "number"
          },
          "variant": "body"
        },
        "children": []
      },
      "invoice-date": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "date"
          },
          "variant": "muted"
        },
        "children": []
      },
      "invoice-right": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center"
        },
        "children": [
          "invoice-amount",
          "invoice-status",
          "invoice-link"
        ]
      },
      "invoice-amount": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "amount"
          },
          "variant": "body"
        },
        "children": []
      },
      "invoice-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "invoice-link": {
        "type": "Link",
        "props": {
          "label": "Download PDF",
          "href": "#"
        },
        "children": []
      },
      "danger-card": {
        "type": "Card",
        "props": {
          "title": "Cancel Subscription",
          "description": "You'll keep access until the end of your current billing period.",
          "maxWidth": "full"
        },
        "children": [
          "danger-actions"
        ]
      },
      "danger-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm"
        },
        "children": [
          "cancel-btn",
          "resume-btn"
        ]
      },
      "cancel-btn": {
        "type": "Button",
        "props": {
          "label": "Cancel Plan",
          "variant": "danger"
        },
        "visible": {
          "$state": "/planStatus",
          "neq": "cancelled"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showCancel",
              "value": true
            }
          }
        },
        "children": []
      },
      "resume-btn": {
        "type": "Button",
        "props": {
          "label": "Resume Subscription",
          "variant": "primary"
        },
        "visible": {
          "$state": "/planStatus",
          "eq": "cancelled"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/planStatus",
              "value": "active"
            }
          }
        },
        "children": []
      },
      "change-dialog": {
        "type": "Dialog",
        "props": {
          "title": "Change Plan",
          "description": "Choose a plan and billing cycle. Changes apply immediately, prorated.",
          "openPath": "/showChangePlan"
        },
        "children": [
          "plan-radio",
          "cycle-group",
          "plan-summary",
          "change-actions"
        ]
      },
      "plan-radio": {
        "type": "Radio",
        "props": {
          "label": "Plan",
          "name": "plan",
          "options": [
            "Starter",
            "Pro",
            "Business"
          ],
          "value": {
            "$bindState": "/selectedPlan"
          },
          "checks": [
            {
              "type": "required",
              "message": "Please select a plan"
            }
          ]
        },
        "children": []
      },
      "cycle-group": {
        "type": "ButtonGroup",
        "props": {
          "buttons": [
            {
              "label": "Monthly",
              "value": "monthly"
            },
            {
              "label": "Yearly (save 17%)",
              "value": "yearly"
            }
          ],
          "selected": {
            "$bindState": "/billingCycle"
          }
        },
        "children": []
      },
      "plan-summary": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "Selected: ${/selectedPlan} plan, billed ${/billingCycle}."
          },
          "variant": "muted"
        },
        "children": []
      },
      "change-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "change-cancel",
          "change-save"
        ]
      },
      "change-cancel": {
        "type": "Button",
        "props": {
          "label": "Close",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showChangePlan",
              "value": false
            }
          }
        },
        "children": []
      },
      "change-save": {
        "type": "Button",
        "props": {
          "label": "Confirm Change",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showChangePlan",
              "value": false
            }
          }
        },
        "children": []
      },
      "cancel-dialog": {
        "type": "Dialog",
        "props": {
          "title": "Cancel your subscription?",
          "description": "We're sorry to see you go. Your access continues until Nov 29, 2026.",
          "openPath": "/showCancel"
        },
        "children": [
          "cancel-reason",
          "cancel-check",
          "cancel-actions"
        ]
      },
      "cancel-reason": {
        "type": "Select",
        "props": {
          "label": "Reason for cancelling",
          "name": "reason",
          "options": [
            "Too expensive",
            "Missing features",
            "Not using it enough",
            "Switching to another product",
            "Other"
          ],
          "placeholder": "Select a reason",
          "value": {
            "$bindState": "/cancelReason"
          }
        },
        "children": []
      },
      "cancel-check": {
        "type": "Checkbox",
        "props": {
          "label": "I understand I will lose access to paid features after Nov 29, 2026",
          "name": "confirm",
          "checked": {
            "$bindState": "/cancelConfirm"
          }
        },
        "children": []
      },
      "cancel-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "keep-btn",
          "confirm-cancel-btn"
        ]
      },
      "keep-btn": {
        "type": "Button",
        "props": {
          "label": "Keep Plan",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showCancel",
              "value": false
            }
          }
        },
        "children": []
      },
      "confirm-cancel-btn": {
        "type": "Button",
        "props": {
          "label": "Confirm Cancellation",
          "variant": "danger",
          "disabled": {
            "$state": "/cancelConfirm",
            "not": true
          }
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/planStatus",
                "value": "cancelled"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/showCancel",
                "value": false
              }
            }
          ]
        },
        "children": []
      },
      "payment-dialog": {
        "type": "Dialog",
        "props": {
          "title": "Update Payment Method",
          "description": "Enter your new card details.",
          "openPath": "/showPayment"
        },
        "children": [
          "pay-name",
          "pay-number",
          "pay-row",
          "pay-actions"
        ]
      },
      "pay-name": {
        "type": "Input",
        "props": {
          "label": "Name on card",
          "name": "cardName",
          "placeholder": "Jane Doe",
          "value": {
            "$bindState": "/newCard/name"
          },
          "checks": [
            {
              "type": "required",
              "message": "Name is required"
            }
          ]
        },
        "children": []
      },
      "pay-number": {
        "type": "Input",
        "props": {
          "label": "Card number",
          "name": "cardNumber",
          "placeholder": "4242 4242 4242 4242",
          "value": {
            "$bindState": "/newCard/number"
          },
          "checks": [
            {
              "type": "required",
              "message": "Card number is required"
            },
            {
              "type": "minLength",
              "message": "Enter a valid card number",
              "args": {
                "min": 13
              }
            }
          ]
        },
        "children": []
      },
      "pay-row": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "md"
        },
        "children": [
          "pay-expiry",
          "pay-cvc"
        ]
      },
      "pay-expiry": {
        "type": "Input",
        "props": {
          "label": "Expiry",
          "name": "expiry",
          "placeholder": "MM/YY",
          "value": {
            "$bindState": "/newCard/expiry"
          },
          "checks": [
            {
              "type": "required",
              "message": "Expiry is required"
            }
          ]
        },
        "children": []
      },
      "pay-cvc": {
        "type": "Input",
        "props": {
          "label": "CVC",
          "name": "cvc",
          "type": "password",
          "placeholder": "123",
          "value": {
            "$bindState": "/newCard/cvc"
          },
          "checks": [
            {
              "type": "required",
              "message": "CVC is required"
            },
            {
              "type": "minLength",
              "message": "Min 3 digits",
              "args": {
                "min": 3
              }
            }
          ]
        },
        "children": []
      },
      "pay-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "pay-cancel",
          "pay-save"
        ]
      },
      "pay-cancel": {
        "type": "Button",
        "props": {
          "label": "Cancel",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showPayment",
              "value": false
            }
          }
        },
        "children": []
      },
      "pay-save": {
        "type": "Button",
        "props": {
          "label": "Save Card",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "validateForm",
            "params": {
              "statePath": "/paymentValidation"
            }
          }
        },
        "children": []
      }
    },
    "state": {
      "selectedPlan": "Pro",
      "showChangePlan": false,
      "showCancel": false,
      "showPayment": false,
      "planStatus": "active",
      "billingCycle": "monthly",
      "cancelReason": "",
      "cancelConfirm": false,
      "newCard": {
        "name": "",
        "number": "",
        "expiry": "",
        "cvc": ""
      },
      "invoices": [
        {
          "id": "inv-1",
          "number": "INV-2026-010",
          "date": "Oct 29, 2026",
          "amount": "$19.00",
          "status": "Paid"
        },
        {
          "id": "inv-2",
          "number": "INV-2026-009",
          "date": "Sep 29, 2026",
          "amount": "$19.00",
          "status": "Paid"
        },
        {
          "id": "inv-3",
          "number": "INV-2026-008",
          "date": "Aug 29, 2026",
          "amount": "$19.00",
          "status": "Paid"
        },
        {
          "id": "inv-4",
          "number": "INV-2026-007",
          "date": "Jul 29, 2026",
          "amount": "$19.00",
          "status": "Paid"
        }
      ]
    }
  },
  "patchLines": 78,
  "skippedLines": 0,
  "firstNodeMs": 5934,
  "issues": [],
  "fixes": []
}
