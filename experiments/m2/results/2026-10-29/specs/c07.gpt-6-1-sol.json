            }
          ]
        },
        {
          "id": "ord-10391",
          "orderNumber": "CH-10391",
          "placed": "October 24, 2026",
          "status": "In transit",
          "statusVariant": "default",
          "delivery": "Estimated delivery October 30",
          "total": "$20.00",
