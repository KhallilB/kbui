{
  "spec": {
    "root": "page",
    "elements": {
      "page": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "className": "max-w-5xl mx-auto p-6"
        },
        "children": [
          "header",
          "alert-new",
          "create-card",
          "keys-card",
          "revoke-dialog"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center"
        },
        "children": [
          "header-text",
          "create-open-btn"
        ]
      },
      "header-text": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "API Keys",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Create and manage secret keys used to authenticate requests to the platform API.",
          "variant": "muted"
        },
        "children": []
      },
      "create-open-btn": {
        "type": "Button",
        "props": {
          "label": "Create new key",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showCreate",
              "value": true
            }
          }
        },
        "children": []
      },
      "alert-new": {
        "type": "Alert",
        "props": {
          "title": "Key copied to clipboard",
          "message": "Store your key somewhere safe. Treat it like a password and never commit it to source control.",
          "type": "success"
        },
        "visible": {
          "$state": "/copied",
          "not": true,
          "neq": ""
        },
        "children": []
      },
      "create-card": {
        "type": "Card",
        "props": {
          "title": "Create a new API key",
          "description": "Give your key a name and choose its permissions and environment.",
          "maxWidth": "full"
        },
        "visible": {
          "$state": "/showCreate"
        },
        "children": [
          "create-form"
        ]
      },
      "create-form": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "new-name",
          "create-grid",
          "new-expiry",
          "create-actions"
        ]
      },
      "new-name": {
        "type": "Input",
        "props": {
          "label": "Key name",
          "name": "keyName",
          "type": "text",
          "placeholder": "e.g. Production backend",
          "value": {
            "$bindState": "/newKey/name"
          },
          "checks": [
            {
              "type": "required",
              "message": "Key name is required"
            },
            {
              "type": "minLength",
              "message": "Name must be at least 3 characters",
              "args": {
                "min": 3
              }
            }
          ],
          "validateOn": "blur"
        },
        "children": []
      },
      "create-grid": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "md"
        },
        "children": [
          "new-env",
          "new-scope"
        ]
      },
      "new-env": {
        "type": "Select",
        "props": {
          "label": "Environment",
          "name": "environment",
          "options": [
            "Production",
            "Staging",
            "Development"
          ],
          "placeholder": "Select environment",
          "value": {
            "$bindState": "/newKey/environment"
          },
          "checks": [
            {
              "type": "required",
              "message": "Choose an environment"
            }
          ]
        },
        "children": []
      },
      "new-scope": {
        "type": "Select",
        "props": {
          "label": "Permissions",
          "name": "permissions",
          "options": [
            "Read only",
            "Read & write",
            "Admin"
          ],
          "placeholder": "Select permissions",
          "value": {
            "$bindState": "/newKey/permissions"
          },
          "checks": [
            {
              "type": "required",
              "message": "Choose permissions"
            }
          ]
        },
        "children": []
      },
      "new-expiry": {
        "type": "Radio",
        "props": {
          "label": "Expiration",
          "name": "expiry",
          "options": [
            "30 days",
            "90 days",
            "1 year",
            "Never"
          ],
          "value": {
            "$bindState": "/newKey/expiry"
          }
        },
        "children": []
      },
      "create-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "cancel-btn",
          "create-btn"
        ]
      },
      "cancel-btn": {
        "type": "Button",
        "props": {
          "label": "Cancel",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showCreate",
              "value": false
            }
          }
        },
        "children": []
      },
      "create-btn": {
        "type": "Button",
        "props": {
          "label": "Generate key",
          "variant": "primary"
        },
        "on": {
          "press": [
            {
              "action": "validateForm",
              "params": {
                "statePath": "/formValidation"
              }
            },
            {
              "action": "pushState",
              "params": {
                "statePath": "/keys",
                "value": {
                  "id": "$id",
                  "name": {
                    "$state": "/newKey/name"
                  },
                  "prefix": "sk_live_••••••••••••new1",
                  "environment": {
                    "$state": "/newKey/environment"
                  },
                  "permissions": {
                    "$state": "/newKey/permissions"
                  },
                  "created": "Oct 29, 2026",
                  "lastUsed": "Never",
                  "status": "Active"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/showCreate",
                "value": false
              }
            }
          ]
        },
        "children": []
      },
      "keys-card": {
        "type": "Card",
        "props": {
          "title": "Your keys",
          "description": "Keys are shown masked. Copy a key to use it, or revoke it if it is compromised.",
          "maxWidth": "full"
        },
        "children": [
          "keys-list",
          "empty-note"
        ]
      },
      "keys-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/keys",
          "key": "id"
        },
        "children": [
          "key-row"
        ]
      },
      "key-row": {
        "type": "Card",
        "props": {
          "maxWidth": "full"
        },
        "children": [
          "key-row-inner"
        ]
      },
      "key-row-inner": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center",
          "gap": "md"
        },
        "children": [
          "key-info",
          "key-actions"
        ]
      },
      "key-info": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "key-title-row",
          "key-secret",
          "key-meta"
        ]
      },
      "key-title-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "key-name",
          "key-env",
          "key-status"
        ]
      },
      "key-name": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "name"
          },
          "level": "h3"
        },
        "children": []
      },
      "key-env": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "environment"
          },
          "variant": "outline"
        },
        "children": []
      },
      "key-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "key-secret": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "prefix"
          },
          "variant": "code"
        },
        "children": []
      },
      "key-meta": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${permissions} · Created ${created} · Last used ${lastUsed}"
          },
          "variant": "caption"
        },
        "children": []
      },
      "key-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm"
        },
        "children": [
          "copy-btn",
          "revoke-btn"
        ]
      },
      "copy-btn": {
        "type": "Button",
        "props": {
          "label": "Copy",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/copied",
              "value": {
                "$item": "id"
              }
            }
          }
        },
        "children": []
      },
      "revoke-btn": {
        "type": "Button",
        "props": {
          "label": "Revoke",
          "variant": "danger"
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/revokeIndex",
                "value": {
                  "$index": true
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/revokeName",
                "value": {
                  "$item": "name"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/revokeOpen",
                "value": true
              }
            }
          ]
        },
        "children": []
      },
      "empty-note": {
        "type": "Text",
        "props": {
          "text": "Keys are only shown once at creation. If you lose a key, revoke it and create a new one.",
          "variant": "muted"
        },
        "children": []
      },
      "revoke-dialog": {
        "type": "Dialog",
        "props": {
          "title": "Revoke API key?",
          "description": "Any application using this key will immediately lose access. This action cannot be undone.",
          "openPath": "/revokeOpen"
        },
        "children": [
          "revoke-name-text",
          "revoke-actions"
        ]
      },
      "revoke-name-text": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "You are about to revoke: ${/revokeName}"
          },
          "variant": "lead"
        },
        "children": []
      },
      "revoke-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "revoke-cancel",
          "revoke-confirm"
        ]
      },
      "revoke-cancel": {
        "type": "Button",
        "props": {
          "label": "Cancel",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/revokeOpen",
              "value": false
            }
          }
        },
        "children": []
      },
      "revoke-confirm": {
        "type": "Button",
        "props": {
          "label": "Revoke key",
          "variant": "danger"
        },
        "on": {
          "press": [
            {
              "action": "removeState",
              "params": {
                "statePath": "/keys",
                "index": {
                  "$state": "/revokeIndex"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/revokeOpen",
                "value": false
              }
            }
          ]
        },
        "children": []
      }
    },
    "state": {
      "showCreate": false,
      "copied": "",
      "revokeOpen": false,
      "revokeIndex": 0,
      "revokeName": "",
      "newKey": {
        "name": "",
        "environment": "Production",
        "permissions": "Read only",
        "expiry": "90 days"
      },
      "formValidation": {
        "valid": false,
        "errors": {}
      },
      "keys": [
        {
          "id": "key_1",
          "name": "Production backend",
          "prefix": "sk_live_••••••••••••a91f",
          "environment": "Production",
          "permissions": "Read & write",
          "created": "Aug 14, 2026",
          "lastUsed": "2 minutes ago",
          "status": "Active"
        },
        {
          "id": "key_2",
          "name": "Staging CI pipeline",
          "prefix": "sk_test_••••••••••••c33d",
          "environment": "Staging",
          "permissions": "Read & write",
          "created": "Sep 02, 2026",
          "lastUsed": "Yesterday",
          "status": "Active"
        },
        {
          "id": "key_3",
          "name": "Analytics dashboard",
          "prefix": "sk_live_••••••••••••77be",
          "environment": "Production",
          "permissions": "Read only",
          "created": "Sep 21, 2026",
          "lastUsed": "3 days ago",
          "status": "Active"
        },
        {
          "id": "key_4",
          "name": "Local development",
          "prefix": "sk_test_••••••••••••02e8",
          "environment": "Development",
          "permissions": "Admin",
          "created": "Oct 10, 2026",
          "lastUsed": "Oct 27, 2026",
          "status": "Active"
        }
      ]
    }
  },
  "patchLines": 50,
  "skippedLines": 0,
  "firstNodeMs": 6075,
  "issues": [],
  "fixes": []
}
