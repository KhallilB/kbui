{
  "spec": {
    "root": "dashboard",
    "elements": {
      "dashboard": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "className": "mx-auto max-w-7xl p-6"
        },
        "children": [
          "header",
          "metrics",
          "assignment",
          "roster"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "eyebrow",
          "title",
          "subtitle"
        ]
      },
      "eyebrow": {
        "type": "Badge",
        "props": {
          "text": "TEACHER WORKSPACE",
          "variant": "secondary"
        },
        "children": []
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Your classroom, at a glance",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/classroom/subtitle"
          },
          "variant": "muted"
        },
        "children": []
      },
      "metrics": {
        "type": "Grid",
        "props": {
          "columns": 3,
          "gap": "lg",
          "className": "grid-cols-1 md:grid-cols-3"
        },
        "children": [
          "attendance-summary",
          "assignment-summary",
          "class-summary"
        ]
      },
      "attendance-summary": {
        "type": "Card",
        "props": {
          "title": "Today's attendance",
          "description": "Recorded at 9:05 AM"
        },
        "children": [
          "attendance-count",
          "attendance-progress",
          "attendance-note"
        ]
      },
      "attendance-count": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/attendance/count"
          },
          "level": "h2"
        },
        "children": []
      },
      "attendance-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$state": "/attendance/percentage"
          },
          "max": 100,
          "label": "Attendance · 94%"
        },
        "children": []
      },
      "attendance-note": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/attendance/note"
          },
          "variant": "muted"
        },
        "children": []
      },
      "assignment-summary": {
        "type": "Card",
        "props": {
          "title": "Assignment completion",
          "description": "Linear Equations Practice"
        },
        "children": [
          "completion-count",
          "completion-progress",
          "completion-note"
        ]
      },
      "completion-count": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/completion/count"
          },
          "level": "h2"
        },
        "children": []
      },
      "completion-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$state": "/completion/percentage"
          },
          "max": 100,
          "label": "Assignment completion · 84%"
        },
        "children": []
      },
      "completion-note": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/completion/note"
          },
          "variant": "muted"
        },
        "children": []
      },
      "class-summary": {
        "type": "Card",
        "props": {
          "title": "Class roster",
          "description": "Every student, in one place"
        },
        "children": [
          "student-count",
          "grade-note"
        ]
      },
      "student-count": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/classroom/studentCount"
          },
          "level": "h2"
        },
        "children": []
      },
      "grade-note": {
        "type": "Text",
        "props": {
          "text": "Grades show each student's current overall course percentage.",
          "variant": "muted"
        },
        "children": []
      },
      "assignment": {
        "type": "Alert",
        "props": {
          "title": "Coming up: Linear Equations Practice",
          "message": "Due Friday, October 30 at 3:00 PM. Five students still need to submit; check the roster below for follow-up.",
          "type": "info"
        },
        "children": []
      },
      "roster": {
        "type": "Card",
        "props": {
          "maxWidth": "full"
        },
        "children": [
          "roster-heading",
          "roster-caption",
          "column-headings",
          "student-list"
        ]
      },
      "roster-heading": {
        "type": "Heading",
        "props": {
          "text": "Student roster",
          "level": "h2"
        },
        "children": []
      },
      "roster-caption": {
        "type": "Text",
        "props": {
          "text": "Alphabetical by last name · Attendance for today · Completion for Linear Equations Practice",
          "variant": "muted"
        },
        "children": []
      },
      "column-headings": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "mt-6 border-b pb-3"
        },
        "children": [
          "column-student",
          "column-grade",
          "column-attendance",
          "column-assignment"
        ]
      },
      "column-student": {
        "type": "Text",
        "props": {
          "text": "STUDENT",
          "variant": "caption"
        },
        "children": []
      },
      "column-grade": {
        "type": "Text",
        "props": {
          "text": "COURSE GRADE",
          "variant": "caption"
        },
        "children": []
      },
      "column-attendance": {
        "type": "Text",
        "props": {
          "text": "ATTENDANCE",
          "variant": "caption"
        },
        "children": []
      },
      "column-assignment": {
        "type": "Text",
        "props": {
          "text": "ASSIGNMENT",
          "variant": "caption"
        },
        "children": []
      },
      "student-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "none"
        },
        "repeat": {
          "statePath": "/students",
          "key": "id"
        },
        "children": [
          "student-row"
        ]
      },
      "student-row": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "items-center border-b border-slate-100 py-4"
        },
        "children": [
          "student-name",
          "student-grade",
          "student-attendance",
          "student-completion"
        ]
      },
      "student-name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          }
        },
        "children": []
      },
      "student-grade": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${grade}%"
          }
        },
        "children": []
      },
      "student-attendance": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "attendance"
          },
          "variant": {
            "$cond": {
              "$item": "attendance",
              "eq": "Absent"
            },
            "$then": "destructive",
            "$else": "secondary"
          }
        },
        "children": []
      },
      "student-completion": {
        "type": "Badge",
        "props": {
          "text": {
            "$cond": {
              "$item": "submitted",
              "eq": true
            },
            "$then": "Submitted",
            "$else": "Pending"
          },
          "variant": {
            "$cond": {
              "$item": "submitted",
              "eq": true
            },
            "$then": "secondary",
            "$else": "outline"
          }
        },
        "children": []
      }
    },
