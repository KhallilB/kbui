{
  "spec": {
    "root": "main",
    "elements": {
      "main": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "className": "max-w-3xl mx-auto p-6"
        },
        "children": [
          "header",
          "status-paused",
          "status-cancelled",
          "current-card",
          "frequency-card",
          "manage-card",
          "pause-dialog",
          "cancel-dialog"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "My Subscription",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Manage your coffee deliveries, change frequency, pause, or cancel anytime.",
          "variant": "muted"
        },
        "children": []
      },
      "status-paused": {
        "type": "Alert",
        "props": {
          "title": "Subscription paused",
          "message": "Your deliveries are on hold. You can resume anytime.",
          "type": "warning"
        },
        "visible": {
          "$state": "/subscription/status",
          "eq": "paused"
        },
        "children": []
      },
      "status-cancelled": {
        "type": "Alert",
        "props": {
          "title": "Subscription cancelled",
          "message": "We're sorry to see you go. You will not be charged again.",
          "type": "error"
        },
        "visible": {
          "$state": "/subscription/status",
          "eq": "cancelled"
        },
        "children": []
      },
      "current-card": {
        "type": "Card",
        "props": {
          "title": "Current Subscription",
          "description": "Your active coffee plan",
          "maxWidth": "full"
        },
        "children": [
          "current-stack"
        ]
      },
      "current-stack": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "lg",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "current-info",
          "current-badge"
        ]
      },
      "current-info": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "plan-name",
          "plan-details",
          "plan-price",
          "plan-next",
          "plan-freq"
        ]
      },
      "plan-name": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/subscription/plan"
          },
          "level": "h2"
        },
        "children": []
      },
      "plan-details": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${/subscription/roast} · ${/subscription/size}"
          },
          "variant": "body"
        },
        "children": []
      },
      "plan-price": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "Price per delivery: ${/subscription/price}"
          },
          "variant": "lead"
        },
        "children": []
      },
      "plan-next": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "Next delivery: ${/subscription/nextDelivery}"
          },
          "variant": "muted"
        },
        "visible": {
          "$state": "/subscription/status",
          "eq": "active"
        },
        "children": []
      },
      "plan-freq": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "Frequency: ${/subscription/frequency}"
          },
          "variant": "muted"
        },
        "children": []
      },
      "current-badge": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/subscription/status"
          },
          "variant": {
            "$cond": {
              "$state": "/subscription/status",
              "eq": "active"
            },
            "$then": "default",
            "$else": "secondary"
          }
        },
        "children": []
      },
      "frequency-card": {
        "type": "Card",
        "props": {
          "title": "Delivery Frequency",
          "description": "Choose how often you'd like your coffee delivered",
          "maxWidth": "full"
        },
        "visible": {
          "$state": "/subscription/status",
          "neq": "cancelled"
        },
        "children": [
          "freq-stack"
        ]
      },
      "freq-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "freq-radio",
          "saved-alert",
          "freq-save"
        ]
      },
      "freq-radio": {
        "type": "Radio",
        "props": {
          "label": "Deliver my coffee",
          "name": "frequency",
          "options": [
            "Every week",
            "Every 2 weeks",
            "Every 4 weeks",
            "Every 8 weeks"
          ],
          "value": {
            "$bindState": "/frequency"
          }
        },
        "children": []
      },
      "saved-alert": {
        "type": "Alert",
        "props": {
          "title": "Frequency updated",
          "message": "Your delivery schedule has been saved.",
          "type": "success"
        },
        "visible": {
          "$state": "/saved"
        },
        "children": []
      },
      "freq-save": {
        "type": "Button",
        "props": {
          "label": "Save Frequency",
          "variant": "primary"
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/subscription/frequency",
                "value": {
                  "$state": "/frequency"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/saved",
                "value": true
              }
            }
          ]
        },
        "children": []
      },
      "manage-card": {
        "type": "Card",
        "props": {
          "title": "Manage Subscription",
          "description": "Take a break or end your subscription",
          "maxWidth": "full"
        },
        "children": [
          "manage-stack"
        ]
      },
      "manage-stack": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center"
        },
        "children": [
          "pause-btn",
          "resume-btn",
          "cancel-btn",
          "reactivate-btn"
        ]
      },
      "pause-btn": {
        "type": "Button",
        "props": {
          "label": "Pause Subscription",
          "variant": "secondary"
        },
        "visible": {
          "$state": "/subscription/status",
          "eq": "active"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showPause",
              "value": true
            }
          }
        },
        "children": []
      },
      "resume-btn": {
        "type": "Button",
        "props": {
          "label": "Resume Subscription",
          "variant": "primary"
        },
        "visible": {
          "$state": "/subscription/status",
          "eq": "paused"
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/subscription/status",
                "value": "active"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/saved",
                "value": false
              }
            }
          ]
        },
        "children": []
      },
      "cancel-btn": {
        "type": "Button",
        "props": {
          "label": "Cancel Subscription",
          "variant": "danger"
        },
        "visible": {
          "$state": "/subscription/status",
          "neq": "cancelled"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showCancel",
              "value": true
            }
          }
        },
        "children": []
      },
      "reactivate-btn": {
        "type": "Button",
        "props": {
          "label": "Reactivate Subscription",
          "variant": "primary"
        },
        "visible": {
          "$state": "/subscription/status",
          "eq": "cancelled"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/subscription/status",
              "value": "active"
            }
          }
        },
        "children": []
      },
      "pause-dialog": {
        "type": "Dialog",
        "props": {
          "title": "Pause your subscription",
          "description": "Choose how long to pause. No charges or deliveries during this time.",
          "openPath": "/showPause"
        },
        "children": [
          "pause-stack"
        ]
      },
      "pause-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "pause-select",
          "pause-actions"
        ]
      },
      "pause-select": {
        "type": "Select",
        "props": {
          "label": "Pause for",
          "name": "pauseDuration",
          "options": [
            "2 weeks",
            "1 month",
            "2 months",
            "3 months"
          ],
          "value": {
            "$bindState": "/pauseDuration"
          }
        },
        "children": []
      },
      "pause-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "pause-back",
          "pause-confirm"
        ]
      },
      "pause-back": {
        "type": "Button",
        "props": {
          "label": "Keep Active",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showPause",
              "value": false
            }
          }
        },
        "children": []
      },
      "pause-confirm": {
        "type": "Button",
        "props": {
          "label": "Confirm Pause",
          "variant": "primary"
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/subscription/status",
                "value": "paused"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/showPause",
                "value": false
              }
            }
          ]
        },
        "children": []
      },
      "cancel-dialog": {
        "type": "Dialog",
        "props": {
          "title": "Cancel your subscription?",
          "description": "You'll lose your current pricing and schedule. Consider pausing instead.",
          "openPath": "/showCancel"
        },
        "children": [
          "cancel-stack"
        ]
      },
      "cancel-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "cancel-reason",
          "cancel-actions"
        ]
      },
      "cancel-reason": {
        "type": "Select",
        "props": {
          "label": "Reason for leaving",
          "name": "cancelReason",
          "placeholder": "Select a reason",
          "options": [
            "Too much coffee",
            "Too expensive",
            "Not enjoying the coffee",
            "Switching providers",
            "Other"
          ],
          "value": {
            "$bindState": "/cancelReason"
          }
        },
        "children": []
      },
      "cancel-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "cancel-back",
          "cancel-confirm"
        ]
      },
      "cancel-back": {
        "type": "Button",
        "props": {
          "label": "Keep Subscription",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showCancel",
              "value": false
            }
          }
        },
        "children": []
      },
      "cancel-confirm": {
        "type": "Button",
        "props": {
          "label": "Yes, Cancel",
          "variant": "danger"
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/subscription/status",
                "value": "cancelled"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/showCancel",
                "value": false
              }
            }
          ]
        },
        "children": []
      }
    },
    "state": {
      "subscription": {
        "plan": "Ethiopia Yirgacheffe",
        "roast": "Light Roast",
        "size": "12 oz bag",
        "price": "$18.50",
        "status": "active",
        "nextDelivery": "Nov 5, 2026",
        "frequency": "Every 2 weeks"
      },
      "frequency": "Every 2 weeks",
      "showPause": false,
      "showCancel": false,
      "pauseDuration": "1 month",
      "cancelReason": "",
      "saved": false
    }
  },
  "patchLines": 46,
  "skippedLines": 0,
  "firstNodeMs": 4635,
  "issues": [],
  "fixes": []
}
