{
  "spec": {
    "root": "main",
    "elements": {
      "main": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "className": "p-6 max-w-6xl mx-auto"
        },
        "children": [
          "header",
          "summary-grid",
          "mid-grid",
          "roster-card"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Classroom Dashboard",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${/class/name} · ${/class/period} · ${/class/date}"
          },
          "variant": "muted"
        },
        "children": []
      },
      "summary-grid": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md"
        },
        "children": [
          "sum-att",
          "sum-comp",
          "sum-avg",
          "sum-risk"
        ]
      },
      "sum-att": {
        "type": "Card",
        "props": {
          "title": "Attendance Today",
          "description": "Present or late"
        },
        "children": [
          "sum-att-val",
          "sum-att-note"
        ]
      },
      "sum-att-val": {
        "type": "Heading",
        "props": {
          "text": {
            "$template": "${/summary/attendanceRate}%"
          },
          "level": "h2"
        },
        "children": []
      },
      "sum-att-note": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${/summary/present} present · ${/summary/late} late · ${/summary/absent} absent"
          },
          "variant": "caption"
        },
        "children": []
      },
      "sum-comp": {
        "type": "Card",
        "props": {
          "title": "Assignment Completion",
          "description": "Class average"
        },
        "children": [
          "sum-comp-val",
          "sum-comp-bar"
        ]
      },
      "sum-comp-val": {
        "type": "Heading",
        "props": {
          "text": {
            "$template": "${/summary/completion}%"
          },
          "level": "h2"
        },
        "children": []
      },
      "sum-comp-bar": {
        "type": "Progress",
        "props": {
          "value": {
            "$state": "/summary/completion"
          },
          "max": 100
        },
        "children": []
      },
      "sum-avg": {
        "type": "Card",
        "props": {
          "title": "Class Average",
          "description": "Across all graded work"
        },
        "children": [
          "sum-avg-val",
          "sum-avg-note"
        ]
      },
      "sum-avg-val": {
        "type": "Heading",
        "props": {
          "text": {
            "$template": "${/summary/average}%"
          },
          "level": "h2"
        },
        "children": []
      },
      "sum-avg-note": {
        "type": "Text",
        "props": {
          "text": "Up 1.2 points from last month",
          "variant": "caption"
        },
        "children": []
      },
      "sum-risk": {
        "type": "Card",
        "props": {
          "title": "Needs Attention",
          "description": "Grade below 70%"
        },
        "children": [
          "sum-risk-val",
          "sum-risk-note"
        ]
      },
      "sum-risk-val": {
        "type": "Heading",
        "props": {
          "text": {
            "$template": "${/summary/atRisk} students"
          },
          "level": "h2"
        },
        "children": []
      },
      "sum-risk-note": {
        "type": "Badge",
        "props": {
          "text": "Follow-up recommended",
          "variant": "destructive"
        },
        "children": []
      },
      "mid-grid": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "md"
        },
        "children": [
          "att-card",
          "assign-card"
        ]
      },
      "att-card": {
        "type": "Card",
        "props": {
          "title": "Attendance Breakdown",
          "description": "32 enrolled students"
        },
        "children": [
          "att-stack"
        ]
      },
      "att-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "att-present",
          "att-late",
          "att-absent"
        ]
      },
      "att-present": {
        "type": "Progress",
        "props": {
          "value": 75,
          "max": 100,
          "label": "Present · 24 students"
        },
        "children": []
      },
      "att-late": {
        "type": "Progress",
        "props": {
          "value": 12.5,
          "max": 100,
          "label": "Late · 4 students"
        },
        "children": []
      },
      "att-absent": {
        "type": "Progress",
        "props": {
          "value": 12.5,
          "max": 100,
          "label": "Absent · 4 students"
        },
        "children": []
      },
      "assign-card": {
        "type": "Card",
        "props": {
          "title": "Assignment Completion",
          "description": "Submissions by assignment"
        },
        "children": [
          "assign-list"
        ]
      },
      "assign-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/assignments",
          "key": "id"
        },
        "children": [
          "assign-item"
        ]
      },
      "assign-item": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "percent"
          },
          "max": 100,
          "label": {
            "$template": "${title} · due ${due} · ${submitted}/32 submitted"
          }
        },
        "children": []
      },
      "roster-card": {
        "type": "Card",
        "props": {
          "title": "Student Roster",
          "description": "All 32 students · today's attendance, assignment completion and current grade",
          "maxWidth": "full"
        },
        "children": [
          "roster-head",
          "roster-sep",
          "roster-list"
        ]
      },
      "roster-head": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between",
          "className": "px-2"
        },
        "children": [
          "rh-student",
          "rh-att",
          "rh-comp",
          "rh-grade"
        ]
      },
      "rh-student": {
        "type": "Text",
        "props": {
          "text": "Student",
          "variant": "muted",
          "className": "w-48"
        },
        "children": []
      },
      "rh-att": {
        "type": "Text",
        "props": {
          "text": "Attendance",
          "variant": "muted",
          "className": "w-24"
        },
        "children": []
      },
      "rh-comp": {
        "type": "Text",
        "props": {
          "text": "Assignments",
          "variant": "muted",
          "className": "w-40"
        },
        "children": []
      },
      "rh-grade": {
        "type": "Text",
        "props": {
          "text": "Grade",
          "variant": "muted",
          "className": "w-24"
        },
        "children": []
      },
      "roster-sep": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "roster-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "repeat": {
          "statePath": "/students",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between",
          "className": "px-2 py-1 border-b"
        },
        "children": [
          "row-student",
          "row-att",
          "row-comp",
          "row-grade"
        ]
      },
      "row-student": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "gap": "sm",
          "className": "w-48"
        },
        "children": [
          "row-avatar",
          "row-name"
        ]
      },
      "row-avatar": {
        "type": "Avatar",
        "props": {
          "name": {
            "$item": "name"
          },
          "size": "sm"
        },
        "children": []
      },
      "row-name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "variant": "body"
        },
        "children": []
      },
      "row-att": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "className": "w-24"
        },
        "children": [
          "badge-present",
          "badge-late",
          "badge-absent"
        ]
      },
      "badge-present": {
        "type": "Badge",
        "props": {
          "text": "Present",
          "variant": "secondary"
        },
        "visible": {
          "$item": "attendance",
          "eq": "Present"
        },
        "children": []
      },
      "badge-late": {
        "type": "Badge",
        "props": {
          "text": "Late",
          "variant": "outline"
        },
        "visible": {
          "$item": "attendance",
          "eq": "Late"
        },
        "children": []
      },
      "badge-absent": {
        "type": "Badge",
        "props": {
          "text": "Absent",
          "variant": "destructive"
        },
        "visible": {
          "$item": "attendance",
          "eq": "Absent"
        },
        "children": []
      },
      "row-comp": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "className": "w-40"
        },
        "children": [
          "row-progress"
        ]
      },
      "row-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "completion"
          },
          "max": 100,
          "label": {
            "$template": "${completion}%"
          }
        },
        "children": []
      },
      "row-grade": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${grade} (${score}%)"
          },
          "variant": "body"
        },
        "children": []
      }
    },
