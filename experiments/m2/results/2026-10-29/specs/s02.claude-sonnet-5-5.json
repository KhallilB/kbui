{
  "spec": {
    "root": "main",
    "elements": {
      "main": {
        "type": "Card",
        "props": {
          "title": "Notification Settings",
          "description": "Choose how and when you're notified about project activity",
          "maxWidth": "lg",
          "centered": true
        },
        "children": [
          "layout"
        ]
      },
      "layout": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "children": [
          "saved-alert",
          "tabs",
          "email-section",
          "push-section",
          "inapp-section",
          "sep",
          "quiet-heading",
          "quiet-switch",
          "quiet-times",
          "actions"
        ]
      },
      "saved-alert": {
        "type": "Alert",
        "props": {
          "title": "Preferences saved",
          "message": "Your notification settings have been updated.",
          "type": "success"
        },
        "visible": {
          "$state": "/saved"
        },
        "children": []
      },
      "tabs": {
        "type": "Tabs",
        "props": {
          "tabs": [
            {
              "label": "Email",
              "value": "email"
            },
            {
              "label": "Push",
              "value": "push"
            },
            {
              "label": "In-App",
              "value": "inapp"
            }
          ],
          "value": {
            "$bindState": "/activeTab"
          }
        },
        "children": []
      },
      "email-section": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "visible": {
          "$state": "/activeTab",
          "eq": "email"
        },
        "children": [
          "email-head",
          "email-master",
          "email-digest",
          "email-assigned",
          "email-mentioned",
          "email-comments",
          "email-due",
          "email-status"
        ]
      },
      "email-head": {
        "type": "Heading",
        "props": {
          "text": "Email notifications",
          "level": "h3"
        },
        "children": []
      },
      "email-master": {
        "type": "Switch",
        "props": {
          "label": "Enable email notifications",
          "name": "emailEnabled",
          "checked": {
            "$bindState": "/prefs/email/enabled"
          }
        },
        "children": []
      },
      "email-digest": {
        "type": "Select",
        "props": {
          "label": "Email frequency",
          "name": "emailDigest",
          "options": [
            "Instant",
            "Hourly",
            "Daily",
            "Weekly"
          ],
          "value": {
            "$bindState": "/prefs/email/digest"
          }
        },
        "children": []
      },
      "email-assigned": {
        "type": "Checkbox",
        "props": {
          "label": "Task assigned to me",
          "name": "emailAssigned",
          "checked": {
            "$bindState": "/prefs/email/assigned"
          }
        },
        "children": []
      },
      "email-mentioned": {
        "type": "Checkbox",
        "props": {
          "label": "I'm @mentioned",
          "name": "emailMentioned",
          "checked": {
            "$bindState": "/prefs/email/mentioned"
          }
        },
        "children": []
      },
      "email-comments": {
        "type": "Checkbox",
        "props": {
          "label": "New comments on my tasks",
          "name": "emailComments",
          "checked": {
            "$bindState": "/prefs/email/comments"
          }
        },
        "children": []
      },
      "email-due": {
        "type": "Checkbox",
        "props": {
          "label": "Due date reminders",
          "name": "emailDue",
          "checked": {
            "$bindState": "/prefs/email/dueDate"
          }
        },
        "children": []
      },
      "email-status": {
        "type": "Checkbox",
        "props": {
          "label": "Project status changes",
          "name": "emailStatus",
          "checked": {
            "$bindState": "/prefs/email/statusChange"
          }
        },
        "children": []
      },
      "push-section": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "visible": {
          "$state": "/activeTab",
          "eq": "push"
        },
        "children": [
          "push-head",
          "push-master",
          "push-assigned",
          "push-mentioned",
          "push-comments",
          "push-due",
          "push-status"
        ]
      },
      "push-head": {
        "type": "Heading",
        "props": {
          "text": "Push notifications",
          "level": "h3"
        },
        "children": []
