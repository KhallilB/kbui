            "$bindState": "/prefs/inApp/assigned"
          }
        },
        "children": []
      },
      "inapp-mentioned": {
        "type": "Checkbox",
        "props": {
          "label": "I'm @mentioned",
          "name": "inAppMentioned",
          "checked": {
            "$bindState": "/prefs/inApp/mentioned"
          }
        },
        "children": []
      },
      "inapp-comments": {
        "type": "Checkbox",
        "props": {
          "label": "New comments on my tasks",
          "name": "inAppComments",
          "checked": {
            "$bindState": "/prefs/inApp/comments"
          }
        },
        "children": []
      },
      "inapp-due": {
        "type": "Checkbox",
        "props": {
          "label": "Due date reminders",
          "name": "inAppDue",
          "checked": {
            "$bindState": "/prefs/inApp/dueDate"
          }
        },
        "children": []
      },
      "inapp-status": {
        "type": "Checkbox",
        "props": {
          "label": "Project status changes",
          "name": "inAppStatus",
          "checked": {
            "$bindState": "/prefs/inApp/statusChange"
          }
        },
        "children": []
      },
      "sep": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "quiet-heading": {
        "type": "Heading",
        "props": {
          "text": "Quiet hours",
          "level": "h3"
        },
        "children": []
      },
      "quiet-switch": {
        "type": "Switch",
        "props": {
          "label": "Pause push and email during quiet hours",
          "name": "quietEnabled",
          "checked": {
            "$bindState": "/quiet/enabled"
          }
        },
        "children": []
      },
      "quiet-times": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "visible": {
          "$state": "/quiet/enabled"
        },
        "children": [
          "quiet-start",
          "quiet-end"
        ]
      },
      "quiet-start": {
        "type": "Slider",
        "props": {
          "label": "Start hour (0-23)",
          "min": 0,
          "max": 23,
          "step": 1,
          "value": {
            "$bindState": "/quiet/start"
          }
        },
        "children": []
      },
      "quiet-end": {
        "type": "Slider",
        "props": {
          "label": "End hour (0-23)",
          "min": 0,
          "max": 23,
          "step": 1,
          "value": {
            "$bindState": "/quiet/end"
          }
        },
        "children": []
      },
      "actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "justify": "end"
        },
        "children": [
          "reset-btn",
          "save-btn"
        ]
      },
      "reset-btn": {
        "type": "Button",
        "props": {
          "label": "Reset",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/saved",
              "value": false
            }
          }
        },
        "children": []
      },
      "save-btn": {
        "type": "Button",
        "props": {
          "label": "Save preferences",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/saved",
              "value": true
            }
          }
        },
        "children": []
      }
    },
    "state": {
      "prefs": {
        "email": {
          "enabled": true,
          "digest": "Daily",
          "assigned": true,
          "mentioned": true,
          "comments": false,
          "dueDate": true,
          "statusChange": false
        },
        "push": {
          "enabled": true,
          "assigned": true,
          "mentioned": true,
          "comments": false,
          "dueDate": true,
          "statusChange": false
        },
        "inApp": {
          "enabled": true,
          "assigned": true,
          "mentioned": true,
          "comments": true,
          "dueDate": true,
          "statusChange": true
        }
      },
      "quiet": {
        "enabled": false,
