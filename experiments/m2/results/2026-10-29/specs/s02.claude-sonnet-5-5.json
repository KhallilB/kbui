          "label": "Task assigned to me",
          "name": "pushAssigned",
          "checked": {
            "$bindState": "/prefs/push/assigned"
          }
        },
        "children": []
      },
      "push-mentioned": {
        "type": "Checkbox",
        "props": {
          "label": "I'm @mentioned",
          "name": "pushMentioned",
          "checked": {
            "$bindState": "/prefs/push/mentioned"
          }
        },
        "children": []
      },
      "push-comments": {
        "type": "Checkbox",
        "props": {
          "label": "New comments on my tasks",
          "name": "pushComments",
          "checked": {
            "$bindState": "/prefs/push/comments"
          }
        },
        "children": []
      },
      "push-due": {
        "type": "Checkbox",
        "props": {
          "label": "Due date reminders",
          "name": "pushDue",
          "checked": {
            "$bindState": "/prefs/push/dueDate"
          }
        },
        "children": []
      },
      "push-status": {
        "type": "Checkbox",
        "props": {
          "label": "Project status changes",
          "name": "pushStatus",
          "checked": {
            "$bindState": "/prefs/push/statusChange"
          }
        },
        "children": []
      },
      "inapp-section": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "visible": {
          "$state": "/activeTab",
          "eq": "inapp"
        },
        "children": [
          "inapp-head",
          "inapp-master",
          "inapp-assigned",
          "inapp-mentioned",
          "inapp-comments",
          "inapp-due",
          "inapp-status"
        ]
      },
      "inapp-head": {
        "type": "Heading",
        "props": {
          "text": "In-app notifications",
          "level": "h3"
        },
        "children": []
      },
      "inapp-master": {
        "type": "Switch",
        "props": {
          "label": "Enable in-app notifications",
          "name": "inAppEnabled",
