{
  "spec": {
    "root": "main",
    "elements": {
      "main": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "children": [
          "header",
          "accounts-grid",
          "middle-grid",
          "tx-card"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center"
        },
        "children": [
          "header-text",
          "period-select"
        ]
      },
      "header-text": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Personal Finance Dashboard",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Overview for October 2026",
          "variant": "muted"
        },
        "children": []
      },
      "period-select": {
        "type": "ButtonGroup",
        "props": {
          "buttons": [
            {
              "label": "Week",
              "value": "week"
            },
            {
              "label": "Month",
              "value": "month"
            },
            {
              "label": "Year",
              "value": "year"
            }
          ],
          "selected": {
            "$bindState": "/period"
          }
        },
        "children": []
      },
      "accounts-grid": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md"
        },
        "repeat": {
          "statePath": "/accounts",
          "key": "id"
        },
        "children": [
          "account-card"
        ]
      },
      "account-card": {
        "type": "Card",
        "props": {
          "title": {
            "$item": "name"
          },
          "description": {
            "$item": "type"
          }
        },
        "children": [
          "account-balance",
          "account-change"
        ]
      },
      "account-balance": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "balance"
          },
          "level": "h2"
        },
        "children": []
      },
      "account-change": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "change"
          },
          "variant": "caption"
        },
        "children": []
      },
      "middle-grid": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "md"
        },
        "children": [
          "spending-card",
          "summary-card"
        ]
      },
      "spending-card": {
        "type": "Card",
        "props": {
          "title": "Monthly Spending by Category",
          "description": "Budget usage for October",
          "maxWidth": "full"
        },
        "children": [
          "category-list"
        ]
      },
      "category-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/categories",
          "key": "id"
        },
        "children": [
          "category-row"
        ]
      },
      "category-row": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "category-label",
          "category-progress"
        ]
      },
      "category-label": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${name}: $${spent} of $${budget}"
          },
          "variant": "body"
        },
        "children": []
      },
      "category-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "percent"
          },
          "max": 100
        },
        "children": []
      },
      "summary-card": {
        "type": "Card",
        "props": {
          "title": "Monthly Summary",
          "description": "Income vs. expenses",
          "maxWidth": "full"
        },
        "children": [
          "summary-stack"
        ]
      },
      "summary-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "income-row",
          "expense-row",
          "sep-1",
          "savings-row",
          "over-alert"
        ]
      },
      "income-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center"
        },
        "children": [
          "income-label",
          "income-value"
        ]
      },
      "income-label": {
        "type": "Text",
        "props": {
          "text": "Total Income",
          "variant": "body"
        },
        "children": []
      },
      "income-value": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/summary/income"
          },
          "variant": "default"
        },
        "children": []
      },
      "expense-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center"
        },
        "children": [
          "expense-label",
          "expense-value"
        ]
      },
      "expense-label": {
        "type": "Text",
        "props": {
          "text": "Total Expenses",
          "variant": "body"
        },
        "children": []
      },
      "expense-value": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/summary/expenses"
          },
          "variant": "destructive"
        },
        "children": []
      },
      "sep-1": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "savings-row": {
        "type": "Stack",
