{
  "spec": {
    "root": "sale-page",
    "elements": {
      "sale-page": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "none",
          "className": "min-h-screen bg-stone-50 text-zinc-950"
        },
        "children": [
          "announcement",
          "navigation",
          "hero",
          "benefits",
          "offers",
          "newsletter",
          "footer"
        ]
      },
      "announcement": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "center",
          "className": "bg-lime-300 px-6 py-3 text-center"
        },
        "children": [
          "announcement-text"
        ]
      },
      "announcement-text": {
        "type": "Text",
        "props": {
          "text": "THIS WEEKEND ONLY · Up to 50% off headphones · Ends Sunday at 11:59 PM",
          "variant": "caption"
        },
        "children": []
      },
      "navigation": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between",
          "className": "mx-auto w-full max-w-7xl px-6 py-6"
        },
        "children": [
          "wordmark",
          "navigation-links"
        ]
      },
      "wordmark": {
        "type": "Heading",
        "props": {
          "text": "VOLT /",
          "level": "h2"
        },
        "children": []
      },
      "navigation-links": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "lg",
          "align": "center"
        },
        "children": [
          "audio-link",
          "support-link"
        ]
      },
      "audio-link": {
        "type": "Link",
        "props": {
          "label": "Explore audio",
          "href": "/audio"
        },
        "children": []
      },
      "support-link": {
        "type": "Link",
        "props": {
          "label": "Need a hand?",
          "href": "/support"
        },
        "children": []
      },
      "hero": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "xl",
          "className": "mx-auto w-full max-w-7xl items-center px-6 pb-16 pt-8 max-md:grid-cols-1"
        },
        "children": [
          "hero-copy",
          "hero-visual"
        ]
      },
      "hero-copy": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "align": "start"
        },
        "children": [
          "sale-badge",
          "hero-title",
          "hero-description",
          "hero-cta",
          "hero-fine-print"
        ]
      },
      "sale-badge": {
        "type": "Badge",
        "props": {
          "text": "FRIDAY → SUNDAY / FLASH SALE",
          "variant": "outline"
        },
        "children": []
      },
      "hero-title": {
        "type": "Heading",
        "props": {
          "text": "Big sound.\nSmall prices.",
          "level": "h1"
        },
        "children": []
      },
      "hero-description": {
        "type": "Text",
        "props": {
          "text": "Tune out the noise. Turn up your weekend. Save up to 50% on wireless headphones, everyday earbuds, and your next listening obsession.",
          "variant": "lead"
        },
        "children": []
      },
      "hero-cta": {
        "type": "Link",
        "props": {
          "label": "Shop the flash sale ↗",
          "href": "/sale/headphones"
        },
        "children": []
      },
      "hero-fine-print": {
        "type": "Text",
        "props": {
          "text": "Limited quantities. Offers end Sunday at 11:59 PM PT, while supplies last.",
          "variant": "caption"
        },
        "children": []
      },
      "hero-visual": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md",
          "className": "rounded-3xl bg-zinc-950 p-8 text-white"
        },
        "children": [
          "hero-image",
          "hero-image-caption"
        ]
      },
      "hero-image": {
        "type": "Image",
        "props": {
          "src": "https://images.unsplash.com/photo-1546435770-a3e426bf472b?auto=format&fit=crop&w=1100&q=85",
          "alt": "Over-ear headphones against a warm yellow background",
          "width": 640,
          "height": 480
        },
        "children": []
      },
      "hero-image-caption": {
        "type": "Text",
        "props": {
          "text": "YOUR WEEKEND. REMASTERED.",
          "variant": "caption"
        },
        "children": []
      },
      "benefits": {
        "type": "Grid",
        "props": {
          "columns": 3,
          "gap": "lg",
          "className": "border-y border-zinc-200 px-6 py-6 text-center max-md:grid-cols-1"
        },
        "repeat": {
          "statePath": "/benefits",
          "key": "id"
        },
        "children": [
          "benefit-text"
        ]
      },
      "benefit-text": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "text"
          },
          "variant": "body"
        },
        "children": []
      },
      "offers": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "className": "mx-auto w-full max-w-7xl px-6 py-16"
        },
        "children": [
          "offers-header",
          "product-grid",
          "offers-note"
        ]
      },
      "offers-header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "end",
          "gap": "md",
          "className": "max-md:flex-col max-md:items-start"
        },
        "children": [
          "offers-heading",
          "offers-subtitle"
        ]
      },
      "offers-heading": {
        "type": "Heading",
        "props": {
          "text": "Three ways to tune in.",
          "level": "h2"
        },
        "children": []
      },
      "offers-subtitle": {
        "type": "Text",
        "props": {
          "text": "Excellent audio. Exceptionally good timing.",
          "variant": "muted"
        },
        "children": []
      },
      "product-grid": {
        "type": "Grid",
        "props": {
          "columns": 3,
          "gap": "lg",
          "className": "max-md:grid-cols-1"
        },
        "repeat": {
          "statePath": "/products",
          "key": "id"
        },
        "children": [
          "product-card"
        ]
      },
      "product-card": {
        "type": "Card",
        "props": {
          "maxWidth": "full",
          "className": "h-full rounded-2xl border-zinc-200 bg-white"
        },
        "children": [
          "product-content"
        ]
      },
      "product-content": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md",
          "className": "h-full"
        },
        "children": [
          "product-discount",
          "product-image",
          "product-category",
          "product-name",
          "product-description",
          "product-pricing",
          "product-link"
        ]
      },
      "product-discount": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "discount"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "product-image": {
        "type": "Image",
        "props": {
          "src": {
            "$item": "image"
          },
          "alt": {
            "$item": "imageAlt"
          },
          "width": 400,
          "height": 300
        },
        "children": []
      },
      "product-category": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "category"
          },
          "variant": "caption"
        },
        "children": []
      },
      "product-name": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "name"
          },
          "level": "h3"
        },
        "children": []
      },
      "product-description": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "description"
          },
          "variant": "muted"
        },
        "children": []
      },
      "product-pricing": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center",
          "className": "mt-auto pt-4"
        },
        "children": [
          "product-price",
          "product-original"
        ]
      },
      "product-price": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "price"
          },
          "level": "h3"
        },
        "children": []
      },
      "product-original": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "Was ${originalPrice}"
          },
          "variant": "muted"
        },
        "children": []
      },
      "product-link": {
        "type": "Link",
        "props": {
          "label": {
            "$template": "Shop ${name} ↗"
          },
          "href": {
            "$item": "href"
          }
        },
        "children": []
      },
      "offers-note": {
        "type": "Text",
        "props": {
          "text": "Prices shown in USD, before tax. Discounts apply to selected colors and models. Cannot be combined with other promotions.",
          "variant": "caption"
        },
        "children": []
      },
      "newsletter": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "className": "mx-auto mb-16 w-full max-w-3xl rounded-3xl bg-lime-100 p-8"
        },
        "children": [
          "newsletter-heading",
          "newsletter-description",
          "newsletter-email",
          "newsletter-submit",
          "newsletter-feedback",
          "newsletter-privacy"
        ]
      },
      "newsletter-heading": {
        "type": "Heading",
        "props": {
          "text": "Good deals travel fast.",
          "level": "h2"
        },
        "children": []
      },
      "newsletter-description": {
        "type": "Text",
        "props": {
          "text": "Get the next drop in your inbox. Join our email list for flash sales, new arrivals, and early access.",
          "variant": "body"
        },
        "children": []
      },
      "newsletter-email": {
        "type": "Input",
        "props": {
          "label": "Email address",
          "name": "saleEmail",
          "type": "email",
          "placeholder": "you@example.com",
          "value": {
            "$bindState": "/newsletterEmail"
          },
          "checks": [
            {
              "type": "required",
              "message": "Enter your email address."
            },
            {
              "type": "email",
              "message": "Enter a valid email address."
            }
          ],
          "validateOn": "blur"
        },
        "children": []
      },
      "newsletter-submit": {
        "type": "Button",
        "props": {
          "label": "Check my email",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "validateForm",
            "params": {
              "statePath": "/newsletterValidation"
            }
          }
        },
        "children": []
      },
      "newsletter-feedback": {
        "type": "Alert",
        "props": {
          "title": "Your email looks good",
          "message": "This preview checks your email format. Email subscription is not connected yet.",
          "type": "info"
        },
        "visible": {
          "$state": "/newsletterValidation/valid",
          "eq": true
        },
        "children": []
      },
      "newsletter-privacy": {
        "type": "Text",
        "props": {
          "text": "Sale alerts and product news. Unsubscribe anytime.",
          "variant": "caption"
        },
        "children": []
      },
      "footer": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center",
          "gap": "lg",
          "className": "border-t border-zinc-200 px-6 py-8 max-md:flex-col"
        },
        "children": [
          "footer-brand",
          "footer-links"
        ]
      },
      "footer-brand": {
        "type": "Text",
        "props": {
          "text": "© 2026 VOLT Electronics. Turn your everyday up.",
          "variant": "caption"
        },
        "children": []
      },
      "footer-links": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "lg"
        },
        "children": [
          "returns-link",
          "terms-link",
          "privacy-link"
        ]
      },
      "returns-link": {
        "type": "Link",
        "props": {
