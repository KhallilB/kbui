          "image": "https://images.unsplash.com/photo-1600269452121-4f2416e55c28?auto=format&fit=crop&w=500&q=85"
        },
        {
          "id": "sn-003",
          "name": "Track Runner",
          "category": "Running / Retro",
          "color": "Stone / Slate",
