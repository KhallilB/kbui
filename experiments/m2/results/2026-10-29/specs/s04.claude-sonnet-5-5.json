{
  "spec": {
    "root": "page",
    "elements": {
      "page": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "className": "p-6 max-w-5xl mx-auto"
        },
        "children": [
          "header",
          "stats",
          "members-card",
          "invite-dialog"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "header-text",
          "invite-btn"
        ]
      },
      "header-text": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Team Members",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Manage who has access to your workspace and what they can do.",
          "variant": "muted"
        },
        "children": []
      },
      "invite-btn": {
        "type": "Button",
        "props": {
          "label": "Invite member",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/inviteOpen",
              "value": true
            }
          }
        },
        "children": []
      },
      "stats": {
        "type": "Grid",
        "props": {
          "columns": 3,
          "gap": "md"
        },
        "children": [
          "stat-total",
          "stat-admins",
          "stat-pending"
        ]
      },
      "stat-total": {
        "type": "Card",
        "props": {
          "title": "Total members"
        },
        "children": [
          "stat-total-val"
        ]
      },
      "stat-total-val": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/stats/total"
          },
          "level": "h2"
        },
        "children": []
      },
      "stat-admins": {
        "type": "Card",
        "props": {
          "title": "Admins"
        },
        "children": [
          "stat-admins-val"
        ]
      },
      "stat-admins-val": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/stats/admins"
          },
          "level": "h2"
        },
        "children": []
      },
      "stat-pending": {
        "type": "Card",
        "props": {
          "title": "Pending invites"
        },
        "children": [
          "stat-pending-val"
        ]
      },
      "stat-pending-val": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/stats/pending"
          },
          "level": "h2"
        },
        "children": []
      },
      "members-card": {
        "type": "Card",
        "props": {
          "title": "Members",
          "description": "Change a member's role or remove them from the workspace."
        },
        "children": [
          "members-list"
        ]
      },
      "members-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/members",
          "key": "id"
        },
        "children": [
          "member-row"
        ]
      },
      "member-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between",
          "gap": "md"
        },
        "children": [
          "member-info",
          "member-actions"
        ]
      },
      "member-info": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "gap": "md"
        },
        "children": [
          "member-avatar",
          "member-text",
          "member-status"
        ]
      },
      "member-avatar": {
        "type": "Avatar",
        "props": {
          "name": {
            "$item": "name"
          },
          "size": "md"
        },
        "children": []
      },
      "member-text": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "none"
        },
        "children": [
          "member-name",
          "member-email"
        ]
      },
      "member-name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "variant": "body"
        },
        "children": []
      },
      "member-email": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "email"
          },
          "variant": "muted"
        },
        "children": []
      },
      "member-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": "outline"
        },
        "children": []
      },
      "member-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "gap": "sm"
        },
        "children": [
          "member-role",
          "member-remove"
        ]
      },
      "member-role": {
        "type": "Select",
        "props": {
          "label": "Role",
          "name": "role",
          "options": [
            "Owner",
            "Admin",
            "Editor",
            "Viewer"
          ],
          "value": {
            "$bindItem": "role"
          }
        },
        "children": []
      },
      "member-remove": {
        "type": "Button",
        "props": {
          "label": "Remove",
          "variant": "danger"
        },
        "on": {
          "press": {
            "action": "removeState",
            "params": {
              "statePath": "/members",
              "index": {
                "$index": true
              }
            }
          }
        },
        "children": []
      },
      "invite-dialog": {
        "type": "Dialog",
        "props": {
          "title": "Invite a team member",
          "description": "They'll receive an email with a link to join your workspace.",
          "openPath": "/inviteOpen"
        },
        "children": [
          "invite-form"
        ]
      },
      "invite-form": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "invite-email",
          "invite-role",
          "invite-actions"
        ]
      },
      "invite-email": {
        "type": "Input",
        "props": {
          "label": "Email address",
          "name": "inviteEmail",
          "type": "email",
          "placeholder": "colleague@company.com",
          "value": {
            "$bindState": "/invite/email"
          },
          "checks": [
            {
              "type": "required",
              "message": "Email is required"
            },
            {
              "type": "email",
              "message": "Enter a valid email"
            }
          ],
          "validateOn": "blur"
        },
        "children": []
      },
      "invite-role": {
        "type": "Select",
        "props": {
          "label": "Role",
          "name": "inviteRole",
          "options": [
            "Admin",
            "Editor",
            "Viewer"
          ],
          "placeholder": "Select a role",
          "value": {
            "$bindState": "/invite/role"
          },
          "checks": [
            {
              "type": "required",
              "message": "Choose a role"
            }
          ]
        },
        "children": []
      },
      "invite-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "end",
          "gap": "sm"
        },
        "children": [
          "invite-cancel",
          "invite-send"
        ]
      },
      "invite-cancel": {
        "type": "Button",
        "props": {
          "label": "Cancel",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/inviteOpen",
              "value": false
            }
          }
        },
        "children": []
      },
      "invite-send": {
        "type": "Button",
        "props": {
          "label": "Send invite",
          "variant": "primary"
        },
        "on": {
          "press": [
            {
              "action": "validateForm",
              "params": {
                "statePath": "/inviteValidation"
              }
            },
            {
              "action": "pushState",
              "params": {
                "statePath": "/members",
                "value": {
                  "id": "$id",
                  "name": {
                    "$state": "/invite/email"
                  },
                  "email": {
                    "$state": "/invite/email"
                  },
                  "role": {
                    "$state": "/invite/role"
                  },
                  "status": "Pending"
                },
                "clearStatePath": "/invite/email"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/inviteOpen",
                "value": false
              }
            }
          ]
        },
        "children": []
      }
    },
    "state": {
      "inviteOpen": false,
      "stats": {
        "total": "6",
        "admins": "2",
        "pending": "1"
      },
      "members": [
        {
