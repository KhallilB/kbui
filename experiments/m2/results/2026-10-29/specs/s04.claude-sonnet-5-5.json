        },
        {
          "id": "3",
          "name": "Elena Rossi",
          "email": "elena@acme.io",
          "role": "Editor",
          "status": "Active"
        },
        {
          "id": "4",
          "name": "James O'Connor",
          "email": "james@acme.io",
          "role": "Editor",
          "status": "Active"
        },
        {
          "id": "5",
          "name": "Aisha Khan",
          "email": "aisha@acme.io",
          "role": "Viewer",
          "status": "Active"
        },
        {
          "id": "6",
          "name": "Tom Nguyen",
          "email": "tom@acme.io",
          "role": "Viewer",
          "status": "Pending"
        }
      ],
      "invite": {
        "email": "",
        "role": "Viewer"
      },
      "inviteValidation": {
        "valid": false,
        "errors": {}
      }
    }
  },
  "patchLines": 44,
