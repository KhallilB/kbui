{
  "spec": {
    "root": "main",
    "elements": {
      "main": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "children": [
          "header",
          "kpis",
          "middle",
          "shipments-card",
          "products-card"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Warehouse Inventory Dashboard",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Main Distribution Center · Updated Oct 29, 2026",
          "variant": "muted"
        },
        "children": []
      },
      "kpis": {
        "type": "Grid",
        "props": {
          "columns": 5,
          "gap": "md"
        },
        "repeat": {
          "statePath": "/kpis",
          "key": "id"
        },
        "children": [
          "kpi-card"
        ]
      },
      "kpi-card": {
        "type": "Card",
        "props": {
          "title": {
            "$item": "label"
          }
        },
        "children": [
          "kpi-value",
          "kpi-note"
        ]
      },
      "kpi-value": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "value"
          },
          "level": "h2"
        },
        "children": []
      },
      "kpi-note": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "note"
          },
          "variant": "caption"
        },
        "children": []
      },
      "middle": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "md"
        },
        "children": [
          "levels-card",
          "low-card"
        ]
      },
      "levels-card": {
        "type": "Card",
        "props": {
          "title": "Stock Levels by Category",
          "description": "Share of SKUs at healthy stock levels",
          "maxWidth": "full"
        },
        "children": [
          "levels-list"
        ]
      },
      "levels-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/categories",
          "key": "name"
        },
        "children": [
          "level-item"
        ]
      },
      "level-item": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "pct"
          },
          "max": 100,
          "label": {
            "$template": "${name}: ${units} units · ${healthy} SKUs healthy (${pct}%)"
          }
        },
        "children": []
      },
      "low-card": {
        "type": "Card",
        "props": {
          "title": "Items Running Low",
          "description": "Out of stock and below reorder point",
          "maxWidth": "full"
        },
        "children": [
          "low-list"
        ]
      },
      "low-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "repeat": {
          "statePath": "/lowStock",
          "key": "sku"
        },
        "children": [
          "low-row"
        ]
      },
      "low-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "low-name",
          "low-right"
        ]
      },
      "low-name": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${name} (${sku})"
          },
          "variant": "body"
        },
        "children": []
      },
      "low-right": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "low-qty",
          "low-badge"
        ]
      },
      "low-qty": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${qty} / ${reorder}"
          },
          "variant": "muted"
        },
        "children": []
      },
      "low-badge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": {
            "$item": "variant"
          }
        },
        "children": []
      },
      "shipments-card": {
        "type": "Card",
        "props": {
          "title": "Incoming Shipments",
          "description": "Scheduled inbound deliveries",
          "maxWidth": "full"
        },
        "children": [
          "shipments-table"
        ]
      },
      "shipments-table": {
        "type": "Table",
        "props": {
          "columns": [
            "Shipment",
            "Supplier",
            "Contents",
            "Units",
            "ETA",
            "Status"
          ],
          "rows": {
            "$state": "/shipmentRows"
          }
        },
        "children": []
      },
      "products-card": {
        "type": "Card",
        "props": {
          "title": "Full Product List",
          "description": "All 40 products in inventory",
          "maxWidth": "full"
        },
        "children": [
          "products-table"
        ]
      },
      "products-table": {
        "type": "Table",
        "props": {
          "columns": [
            "SKU",
            "Product",
            "Category",
            "Location",
            "On Hand",
            "Reorder Pt",
            "Status"
          ],
          "rows": {
            "$state": "/productRows"
          },
          "caption": "Showing 40 of 40 products"
        },
        "children": []
      }
    },
