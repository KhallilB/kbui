{
  "spec": {
    "root": "dashboard",
    "elements": {
      "dashboard": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "className": "mx-auto max-w-7xl p-6 lg:p-10 bg-slate-50 text-slate-950"
        },
        "children": [
          "header",
          "metrics",
          "delivery-grid",
          "people-grid",
          "footer"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "lg",
          "align": "center",
          "justify": "between",
          "className": "flex-wrap"
        },
        "children": [
          "project-heading",
          "project-status"
        ]
      },
      "project-heading": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "eyebrow",
          "project-title",
          "project-description"
        ]
      },
      "eyebrow": {
        "type": "Text",
        "props": {
          "text": "WORKSPACE / PROJECT OVERVIEW",
          "variant": "caption"
        },
        "children": []
      },
      "project-title": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/project/name"
          },
          "level": "h1"
        },
        "children": []
      },
      "project-description": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/project/description"
          },
          "variant": "muted"
        },
        "children": []
      },
      "project-status": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm",
          "align": "end"
        },
        "children": [
          "status-badge",
          "update-time"
        ]
      },
      "status-badge": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/project/status"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "update-time": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/project/updated"
          },
          "variant": "caption"
        },
        "children": []
      },
      "metrics": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"
        },
        "repeat": {
          "statePath": "/metrics",
          "key": "id"
        },
        "children": [
          "metric-card"
        ]
      },
      "metric-card": {
        "type": "Card",
        "props": {
          "className": "bg-white"
        },
        "children": [
          "metric-label",
          "metric-value",
          "metric-context"
        ]
      },
      "metric-label": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "label"
          },
          "variant": "muted"
        },
        "children": []
      },
      "metric-value": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "value"
          },
          "level": "h2"
        },
        "children": []
      },
      "metric-context": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "context"
          },
          "variant": "caption"
        },
        "children": []
      },
      "delivery-grid": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "lg",
          "className": "grid-cols-1 lg:grid-cols-2"
        },
        "children": [
          "milestones-card",
          "completion-card"
        ]
      },
      "milestones-card": {
        "type": "Card",
        "props": {
          "title": "Launch milestones",
          "description": "From discovery to general availability.",
          "className": "bg-white"
        },
        "children": [
          "milestones-list"
        ]
      },
      "milestones-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "repeat": {
          "statePath": "/milestones",
          "key": "id"
        },
        "children": [
          "milestone"
        ]
      },
      "milestone": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "milestone-heading",
          "milestone-progress",
          "milestone-meta"
        ]
      },
      "milestone-heading": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "justify": "between",
          "align": "center"
        },
        "children": [
          "milestone-name",
          "milestone-status"
        ]
      },
      "milestone-name": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "name"
          },
          "level": "h3"
        },
        "children": []
      },
      "milestone-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": {
            "$cond": {
              "$item": "status",
              "eq": "Complete"
            },
            "$then": "secondary",
            "$else": "outline"
          }
        },
        "children": []
      },
      "milestone-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "progress"
          },
          "max": 100,
          "label": {
            "$template": "${progress}% complete"
          }
        },
        "children": []
      },
      "milestone-meta": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${date} · ${owner}"
          },
          "variant": "caption"
        },
        "children": []
      },
      "completion-card": {
        "type": "Card",
        "props": {
          "title": "Task completion",
          "description": "A snapshot of delivery across all workstreams.",
          "className": "bg-white"
        },
        "children": [
          "overall-progress",
          "completion-note",
          "completion-separator",
          "workstreams"
        ]
      },
      "overall-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$state": "/completion/percent"
          },
          "max": 100,
          "label": {
            "$state": "/completion/label"
          }
        },
        "children": []
      },
      "completion-note": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/completion/note"
          },
          "variant": "muted"
        },
        "children": []
      },
      "completion-separator": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "workstreams": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "repeat": {
          "statePath": "/workstreams",
          "key": "id"
        },
        "children": [
          "workstream"
        ]
      },
      "workstream": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "workstream-heading",
          "workstream-progress"
        ]
      },
      "workstream-heading": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "workstream-name",
          "workstream-count"
        ]
      },
      "workstream-name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          }
        },
        "children": []
      },
      "workstream-count": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "count"
          },
          "variant": "caption"
        },
        "children": []
      },
      "workstream-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "percent"
          },
          "max": 100,
          "label": {
            "$template": "${name} · ${percent}%"
          }
        },
        "children": []
      },
      "people-grid": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "lg",
          "className": "grid-cols-1 lg:grid-cols-2"
        },
        "children": [
          "workload-card",
          "deadlines-card"
        ]
      },
      "workload-card": {
        "type": "Card",
        "props": {
          "title": "Team workload",
          "description": "Allocated hours / available hours · Oct 26–30",
          "className": "bg-white"
        },
        "children": [
          "capacity-alert",
          "team-list"
        ]
      },
      "capacity-alert": {
        "type": "Alert",
        "props": {
          "title": "Priya is at capacity",
          "message": "Move the next engineering assignment to Noah, who has 8 hours available.",
          "type": "warning"
        },
        "children": []
      },
      "team-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "repeat": {
          "statePath": "/team",
          "key": "id"
        },
        "children": [
          "team-member"
        ]
      },
      "team-member": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "member-heading",
          "member-progress"
        ]
      },
      "member-heading": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "member-identity",
          "member-status"
        ]
      },
      "member-identity": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "member-avatar",
          "member-details"
        ]
      },
      "member-avatar": {
        "type": "Avatar",
        "props": {
          "name": {
            "$item": "name"
          },
          "size": "md"
        },
        "children": []
      },
      "member-details": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "none"
        },
        "children": [
          "member-name",
          "member-role"
        ]
      },
      "member-name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          }
        },
        "children": []
      },
      "member-role": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "role"
          },
          "variant": "caption"
        },
        "children": []
      },
      "member-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": {
            "$cond": {
              "$item": "utilization",
              "gte": 100
            },
            "$then": "default",
            "$else": "outline"
          }
        },
        "children": []
      },
      "member-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "utilization"
          },
          "max": 100,
          "label": {
            "$template": "${hours} allocated · ${utilization}%"
          }
        },
        "children": []
      },
      "deadlines-card": {
        "type": "Card",
        "props": {
          "title": "Upcoming deadlines",
          "description": "Next 7 days · October 30–November 5",
          "className": "bg-white"
        },
        "children": [
          "deadline-list",
          "deadline-separator",
          "deadline-note"
        ]
      },
      "deadline-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "repeat": {
          "statePath": "/deadlines",
          "key": "id"
        },
        "children": [
          "deadline"
        ]
      },
      "deadline": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "deadline-heading",
          "deadline-meta",
          "deadline-risk"
        ]
      },
      "deadline-heading": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "deadline-title",
          "deadline-status"
        ]
      },
      "deadline-title": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "title"
          },
          "level": "h3"
        },
        "children": []
      },
      "deadline-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": {
            "$cond": {
              "$item": "risk",
              "eq": true
            },
            "$then": "destructive",
            "$else": "outline"
          }
        },
        "children": []
      },
      "deadline-meta": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${due} · ${owner}"
          },
          "variant": "caption"
        },
        "children": []
      },
      "deadline-risk": {
        "type": "Text",
        "props": {
          "text": "Waiting on payment-provider sandbox credentials.",
          "variant": "muted"
        },
        "visible": {
          "$item": "risk",
          "eq": true
        },
        "children": []
      },
      "deadline-separator": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "deadline-note": {
        "type": "Text",
        "props": {
          "text": "Next checkpoint: Public beta on November 6.",
          "variant": "muted"
        },
        "children": []
      },
      "footer": {
        "type": "Text",
        "props": {
          "text": "Planning snapshot · Workload reflects this week; task completion reflects the full project.",
          "variant": "caption"
        },
        "children": []
      }
    },
    "state": {
