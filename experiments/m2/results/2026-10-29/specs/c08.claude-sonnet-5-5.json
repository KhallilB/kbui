          "name": "BassBuds Elite",
          "category": "In-Ear",
          "description": "True wireless earbuds with deep bass and IPX5 water resistance.",
          "salePrice": "$69",
          "originalPrice": "$129",
          "discount": "46% OFF"
        },
        {
          "id": "3",
          "name": "StudioMax Reference",
          "category": "Over-Ear",
          "description": "Studio-grade wired headphones with flat, accurate sound response.",
          "salePrice": "$129",
          "originalPrice": "$229",
          "discount": "44% OFF"
        },
        {
          "id": "4",
          "name": "VoltRush Gaming Headset",
          "category": "Gaming",
          "description": "7.1 surround sound, detachable boom mic, and RGB lighting.",
          "salePrice": "$79",
          "originalPrice": "$139",
          "discount": "43% OFF"
        },
        {
          "id": "5",
          "name": "PureSport Wireless",
          "category": "In-Ear",
          "description": "Secure-fit sport earbuds with 12-hour battery and quick charge.",
          "salePrice": "$49",
          "originalPrice": "$89",
          "discount": "45% OFF"
        },
        {
          "id": "6",
          "name": "SkyLounge Comfort",
          "category": "Over-Ear",
          "description": "Lightweight wireless headphones with multipoint Bluetooth 5.3.",
          "salePrice": "$99",
          "originalPrice": "$169",
          "discount": "41% OFF"
        }
      ],
      "cart": [],
      "signup": {
        "email": "",
        "done": false
      }
    }
  },
