{
  "spec": {
    "root": "main",
    "elements": {
      "main": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "align": "stretch"
        },
        "children": [
          "hero",
          "deals-section",
          "features-section",
          "signup-section"
        ]
      },
      "hero": {
        "type": "Card",
        "props": {
          "maxWidth": "full",
          "centered": true
        },
        "children": [
          "hero-stack"
        ]
      },
      "hero-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md",
          "align": "center"
        },
        "children": [
          "hero-badge",
          "hero-title",
          "hero-sub",
          "hero-countdown",
          "hero-cta"
        ]
      },
      "hero-badge": {
        "type": "Badge",
        "props": {
          "text": "Weekend Flash Sale",
          "variant": "destructive"
        },
        "children": []
      },
      "hero-title": {
        "type": "Heading",
        "props": {
          "text": "Up to 50% Off Premium Headphones",
          "level": "h1"
        },
        "children": []
      },
      "hero-sub": {
        "type": "Text",
        "props": {
          "text": "Friday through Sunday only. Top brands, unbeatable prices, free shipping on every order.",
          "variant": "lead"
        },
        "children": []
      },
      "hero-countdown": {
        "type": "Alert",
        "props": {
          "title": "Sale ends Sunday at 11:59 PM",
          "message": "Stock is limited. Once it's gone, it's gone!",
          "type": "warning"
        },
        "children": []
      },
      "hero-cta": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "justify": "center"
        },
        "children": [
          "cta-shop",
          "cta-link"
        ]
      },
      "cta-shop": {
        "type": "Button",
        "props": {
          "label": "Shop the Sale",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/category",
              "value": "All"
            }
          }
        },
        "children": []
      },
      "cta-link": {
        "type": "Link",
        "props": {
          "label": "View sale terms",
          "href": "#terms"
        },
        "children": []
      },
      "deals-section": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "deals-heading",
          "category-filter",
          "deals-grid"
        ]
      },
      "deals-heading": {
        "type": "Heading",
        "props": {
          "text": "Featured Deals",
          "level": "h2"
        },
        "children": []
      },
      "category-filter": {
        "type": "ButtonGroup",
        "props": {
          "buttons": [
            {
              "label": "All",
              "value": "All"
            },
            {
              "label": "Over-Ear",
              "value": "Over-Ear"
            },
            {
              "label": "In-Ear",
              "value": "In-Ear"
            },
            {
              "label": "Gaming",
              "value": "Gaming"
            }
          ],
          "selected": {
            "$bindState": "/category"
          }
        },
        "children": []
      },
      "deals-grid": {
        "type": "Grid",
        "props": {
          "columns": 3,
          "gap": "lg"
        },
        "repeat": {
          "statePath": "/products",
          "key": "id"
        },
        "children": [
          "product-card"
        ]
      },
      "product-card": {
        "type": "Card",
        "props": {
          "maxWidth": "full"
        },
        "visible": {
          "$or": [
            {
              "$state": "/category",
              "eq": "All"
            },
            {
              "$item": "category",
              "eq": "Over-Ear"
            },
            {
              "$item": "category",
              "eq": "In-Ear"
            }
          ]
        },
        "children": [
          "product-stack"
        ]
      },
      "product-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "product-image",
          "product-badge",
          "product-name",
          "product-desc",
          "product-price-row",
          "product-buy"
        ]
      },
      "product-image": {
        "type": "Image",
        "props": {
          "alt": {
            "$item": "name"
          },
          "height": 160
        },
        "children": []
      },
      "product-badge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "discount"
          },
          "variant": "destructive"
        },
        "children": []
      },
      "product-name": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "name"
          },
          "level": "h3"
        },
        "children": []
      },
      "product-desc": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "description"
          },
          "variant": "muted"
        },
        "children": []
      },
      "product-price-row": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${salePrice}  (was ${originalPrice})"
          },
          "variant": "body"
        },
        "children": []
      },
      "product-buy": {
        "type": "Button",
        "props": {
          "label": "Add to Cart",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "pushState",
            "params": {
              "statePath": "/cart",
              "value": {
                "id": "$id",
                "name": {
                  "$item": "name"
                },
                "price": {
                  "$item": "salePrice"
                }
              }
            }
          }
        },
        "children": []
      },
      "features-section": {
        "type": "Grid",
        "props": {
          "columns": 3,
          "gap": "md"
        },
        "children": [
          "feat-1",
          "feat-2",
          "feat-3"
        ]
      },
      "feat-1": {
        "type": "Card",
        "props": {
          "title": "Free Shipping",
          "description": "On every order during the sale weekend, no minimum."
        },
        "children": []
      },
      "feat-2": {
        "type": "Card",
        "props": {
          "title": "30-Day Returns",
          "description": "Not in love with the sound? Return them hassle-free."
        },
        "children": []
      },
      "feat-3": {
        "type": "Card",
        "props": {
          "title": "2-Year Warranty",
          "description": "Every pair is covered by our extended protection plan."
        },
        "children": []
      },
      "signup-section": {
        "type": "Card",
        "props": {
          "title": "Get Early Access to Future Sales",
          "description": "Join our list and never miss a deal.",
          "maxWidth": "md",
          "centered": true
        },
        "children": [
          "signup-stack"
        ]
      },
      "signup-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "signup-email",
          "signup-btn",
          "signup-success"
        ]
      },
      "signup-email": {
        "type": "Input",
        "props": {
          "label": "Email",
          "name": "email",
          "type": "email",
          "placeholder": "you@example.com",
          "value": {
            "$bindState": "/signup/email"
          },
          "checks": [
            {
              "type": "required",
              "message": "Email is required"
            },
            {
              "type": "email",
              "message": "Enter a valid email"
            }
          ],
          "validateOn": "blur"
        },
        "children": []
      },
      "signup-btn": {
        "type": "Button",
        "props": {
          "label": "Notify Me",
          "variant": "primary"
        },
        "on": {
          "press": [
            {
              "action": "validateForm",
              "params": {
                "statePath": "/formValidation"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/signup/done",
                "value": true
              }
            }
          ]
        },
        "children": []
      },
      "signup-success": {
        "type": "Alert",
        "props": {
          "title": "You're on the list!",
          "message": "We'll email you before the next sale.",
          "type": "success"
        },
        "visible": {
          "$state": "/signup/done"
        },
        "children": []
      }
    },
    "state": {
      "category": "All",
      "products": [
        {
          "id": "1",
          "name": "AirTone Pro ANC",
          "category": "Over-Ear",
          "description": "Active noise cancelling, 40-hour battery, plush memory-foam cushions.",
          "salePrice": "$179",
          "originalPrice": "$349",
          "discount": "49% OFF"
        },
        {
