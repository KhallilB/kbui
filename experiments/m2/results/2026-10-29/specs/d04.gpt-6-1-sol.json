{
  "spec": {
    "root": "dashboard",
    "elements": {
      "dashboard": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "className": "mx-auto max-w-7xl p-6 md:p-10"
        },
        "children": [
          "header",
          "health",
          "metrics",
          "infrastructure",
          "incidents"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center",
          "gap": "lg",
          "className": "flex-wrap"
        },
        "children": [
          "heading-group",
          "environment"
        ]
      },
      "heading-group": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "eyebrow",
          "title",
          "subtitle"
        ]
      },
      "eyebrow": {
        "type": "Text",
        "props": {
          "text": "OPERATIONS / INFRASTRUCTURE",
          "variant": "caption"
        },
        "children": []
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Server monitoring",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Production fleet · Sample snapshot · October 29, 2026 at 09:42 PDT",
          "variant": "muted"
        },
        "children": []
      },
      "environment": {
        "type": "Badge",
        "props": {
          "text": "Production · US West",
          "variant": "outline"
        },
        "children": []
      },
      "health": {
        "type": "Alert",
        "props": {
          "title": "All systems operational",
          "message": "12 of 12 servers healthy. No active incidents. Last incident resolved 2 hours ago.",
          "type": "success"
        },
        "children": []
      },
      "metrics": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "grid-cols-1 sm:grid-cols-2 xl:grid-cols-4"
        },
        "repeat": {
          "statePath": "/metrics",
          "key": "id"
        },
        "children": [
          "metric-card"
        ]
      },
      "metric-card": {
        "type": "Card",
        "props": {
          "className": "h-full"
        },
        "children": [
          "metric-content"
        ]
      },
      "metric-content": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "metric-name",
          "metric-value",
          "metric-gauge",
          "metric-context"
        ]
      },
      "metric-name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "variant": "muted"
        },
        "children": []
      },
      "metric-value": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "value"
          },
          "level": "h2"
        },
        "children": []
      },
      "metric-gauge": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "gauge"
          },
          "max": 100,
          "label": {
            "$item": "name"
          }
        },
        "visible": {
          "$item": "showGauge"
        },
        "children": []
      },
      "metric-context": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "context"
          },
          "variant": "caption"
        },
        "children": []
      },
      "infrastructure": {
        "type": "Card",
        "props": {
          "title": "Fleet health",
          "description": "Capacity and availability across production regions."
        },
        "children": [
          "region-list"
        ]
      },
      "region-list": {
        "type": "Grid",
        "props": {
          "columns": 3,
          "gap": "lg",
          "className": "grid-cols-1 md:grid-cols-3"
        },
        "repeat": {
          "statePath": "/regions",
          "key": "id"
        },
        "children": [
          "region"
        ]
      },
      "region": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "region-title",
          "region-status",
          "region-servers",
          "region-latency"
        ]
      },
      "region-title": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "name"
          },
          "level": "h3"
        },
        "children": []
      },
      "region-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "region-servers": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "servers"
          }
        },
        "children": []
      },
      "region-latency": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "latency"
          },
          "variant": "muted"
        },
        "children": []
      },
      "incidents": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "incidents-header",
          "incident-list"
        ]
      },
      "incidents-header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center",
          "gap": "md"
        },
        "children": [
          "incidents-title",
          "incidents-window"
        ]
      },
      "incidents-title": {
        "type": "Heading",
        "props": {
          "text": "Recent incidents",
          "level": "h2"
        },
        "children": []
      },
      "incidents-window": {
        "type": "Text",
        "props": {
          "text": "Last 7 days · All times PDT",
          "variant": "caption"
        },
        "children": []
      },
      "incident-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/incidents",
          "key": "id"
        },
        "children": [
          "incident-card"
        ]
      },
      "incident-card": {
        "type": "Card",
        "props": {
          "title": {
            "$item": "title"
          },
          "description": {
            "$item": "summary"
          }
        },
        "children": [
          "incident-details"
        ]
      },
      "incident-details": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "incident-badges",
          "incident-service",
          "incident-time"
        ]
      },
      "incident-badges": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center",
          "className": "flex-wrap"
        },
        "children": [
          "incident-id",
          "incident-severity",
          "incident-status"
        ]
      },
      "incident-id": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "id"
          },
          "variant": "code"
        },
        "children": []
      },
      "incident-severity": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "severity"
          },
          "variant": "outline"
        },
        "children": []
      },
      "incident-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "incident-service": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "service"
          },
          "variant": "muted"
        },
        "children": []
      },
      "incident-time": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "time"
          },
          "variant": "caption"
        },
        "children": []
      }
    },
    "state": {
      "metrics": [
