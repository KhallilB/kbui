{
  "spec": {
    "root": "main",
    "elements": {
      "main": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "className": "max-w-4xl mx-auto p-6"
        },
        "children": [
          "header",
          "alert-top",
          "tfa-card",
          "sessions-card",
          "activity-card",
          "dlg-disable"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "h1",
          "sub"
        ]
      },
      "h1": {
        "type": "Heading",
        "props": {
          "text": "Security Settings",
          "level": "h1"
        },
        "children": []
      },
      "sub": {
        "type": "Text",
        "props": {
          "text": "Manage how you sign in and keep your account protected.",
          "variant": "muted"
        },
        "children": []
      },
      "alert-top": {
        "type": "Alert",
        "props": {
          "title": "Your account is well protected",
          "message": "Two-factor authentication is on. Last security review: October 2026.",
          "type": "success"
        },
        "visible": {
          "$state": "/twoFactor/enabled"
        },
        "children": []
      },
      "tfa-card": {
        "type": "Card",
        "props": {
          "title": "Two-Factor Authentication",
          "description": "Add an extra layer of security to your account.",
          "maxWidth": "full"
        },
        "children": [
          "tfa-stack"
        ]
      },
      "tfa-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "tfa-row",
          "sep1",
          "tfa-methods",
          "tfa-actions"
        ]
      },
      "tfa-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "tfa-switch",
          "tfa-badge"
        ]
      },
      "tfa-switch": {
        "type": "Switch",
        "props": {
          "label": "Enable two-factor authentication",
          "name": "tfaEnabled",
          "checked": {
            "$bindState": "/twoFactor/enabled"
          }
        },
        "children": []
      },
      "tfa-badge": {
        "type": "Badge",
        "props": {
          "text": {
            "$cond": {
              "$state": "/twoFactor/enabled"
            },
            "$then": "Enabled",
            "$else": "Disabled"
          },
          "variant": {
            "$cond": {
              "$state": "/twoFactor/enabled"
            },
            "$then": "default",
            "$else": "destructive"
          }
        },
        "children": []
      },
      "sep1": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "tfa-methods": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "visible": {
          "$state": "/twoFactor/enabled"
        },
        "children": [
          "method-radio",
          "sms-switch",
          "email-switch"
        ]
      },
      "method-radio": {
        "type": "Radio",
        "props": {
          "label": "Primary method",
          "name": "tfaMethod",
          "options": [
            "Authenticator app",
            "SMS",
            "Security key"
          ],
          "value": {
            "$bindState": "/twoFactor/method"
          }
        },
        "children": []
      },
      "sms-switch": {
        "type": "Switch",
        "props": {
          "label": "Backup codes via SMS",
          "name": "tfaSms",
          "checked": {
            "$bindState": "/twoFactor/sms"
          }
        },
        "children": []
      },
      "email-switch": {
        "type": "Switch",
        "props": {
          "label": "Backup codes via email",
          "name": "tfaEmail",
          "checked": {
            "$bindState": "/twoFactor/email"
          }
        },
        "children": []
      },
      "tfa-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm"
        },
        "children": [
          "btn-codes",
          "btn-disable"
        ]
      },
      "btn-codes": {
        "type": "Button",
        "props": {
          "label": "View backup codes",
          "variant": "secondary"
        },
        "children": []
      },
      "btn-disable": {
        "type": "Button",
        "props": {
          "label": "Disable 2FA",
          "variant": "danger"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showDisable",
              "value": true
            }
          }
        },
        "visible": {
          "$state": "/twoFactor/enabled"
        },
        "children": []
      },
      "dlg-disable": {
        "type": "Dialog",
        "props": {
          "title": "Disable two-factor authentication?",
          "description": "Your account will be less secure without a second verification step.",
          "openPath": "/showDisable"
        },
        "children": [
          "dlg-actions"
        ]
      },
      "dlg-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "dlg-cancel",
          "dlg-confirm"
        ]
      },
      "dlg-cancel": {
        "type": "Button",
        "props": {
          "label": "Cancel",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/showDisable",
              "value": false
            }
          }
        },
        "children": []
      },
      "dlg-confirm": {
        "type": "Button",
        "props": {
          "label": "Yes, disable",
          "variant": "danger"
        },
        "on": {
          "press": [
            {
              "action": "setState",
              "params": {
                "statePath": "/twoFactor/enabled",
                "value": false
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/showDisable",
                "value": false
              }
            }
          ]
        },
        "children": []
      },
      "sessions-card": {
        "type": "Card",
        "props": {
          "title": "Active Sessions",
          "description": "Devices currently signed in to your account.",
          "maxWidth": "full"
        },
        "children": [
          "sessions-stack"
        ]
      },
      "sessions-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "sessions-list",
          "btn-signout-all"
        ]
      },
      "sessions-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/sessions",
          "key": "id"
        },
        "children": [
          "session-row"
        ]
      },
      "session-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center",
          "justify": "between",
          "className": "border rounded-lg p-3"
        },
        "children": [
          "session-info",
          "session-actions"
        ]
      },
      "session-info": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "session-device",
          "session-meta"
        ]
      },
      "session-device": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "device"
          },
          "variant": "lead"
        },
        "children": []
      },
      "session-meta": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${location} • ${ip} • ${lastActive}"
          },
          "variant": "muted"
        },
        "children": []
      },
      "session-actions": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "session-badge",
          "btn-revoke"
        ]
      },
      "session-badge": {
        "type": "Badge",
        "props": {
          "text": {
            "$cond": {
              "$item": "current"
            },
            "$then": "This device",
            "$else": "Active"
          },
          "variant": {
            "$cond": {
              "$item": "current"
            },
            "$then": "default",
            "$else": "outline"
          }
        },
        "children": []
      },
      "btn-revoke": {
        "type": "Button",
        "props": {
          "label": "Revoke",
          "variant": "danger"
        },
        "on": {
          "press": {
            "action": "removeState",
            "params": {
              "statePath": "/sessions",
              "index": {
                "$index": true
              }
            }
          }
        },
        "visible": {
          "$item": "current",
          "not": true
        },
        "children": []
      },
      "btn-signout-all": {
        "type": "Button",
        "props": {
          "label": "Sign out of all other sessions",
          "variant": "secondary"
        },
        "children": []
      },
      "activity-card": {
        "type": "Card",
        "props": {
          "title": "Recent Login Activity",
          "description": "Sign-in attempts over the last 30 days.",
          "maxWidth": "full"
        },
        "children": [
          "activity-stack"
        ]
      },
      "activity-stack": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "children": [
          "activity-table",
          "sep2",
          "alert-prefs-title",
          "alert-new",
          "alert-failed"
        ]
      },
      "activity-table": {
        "type": "Table",
        "props": {
          "columns": [
            "Date",
            "Device",
            "Location",
            "IP Address",
            "Status"
          ],
          "rows": [
            [
              "Oct 29, 2026 09:14",
              "MacBook Pro • Chrome",
              "San Francisco, US",
              "192.168.1.24",
              "Success"
            ],
            [
