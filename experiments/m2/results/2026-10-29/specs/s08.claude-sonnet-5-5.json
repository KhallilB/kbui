            ],
            [
              "Oct 19, 2026 11:30",
              "Unknown • Chrome",
              "Moscow, RU",
              "91.200.4.77",
              "Failed"
            ]
          ],
          "caption": "Showing the 6 most recent sign-in attempts"
        },
        "children": []
      },
      "sep2": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "alert-prefs-title": {
        "type": "Heading",
        "props": {
          "text": "Alert preferences",
          "level": "h3"
        },
        "children": []
      },
      "alert-new": {
        "type": "Switch",
        "props": {
          "label": "Email me when a new device signs in",
          "name": "alertNewLogin",
          "checked": {
            "$bindState": "/alerts/newLogin"
          }
        },
        "children": []
      },
      "alert-failed": {
        "type": "Switch",
        "props": {
          "label": "Email me about failed or blocked login attempts",
          "name": "alertFailed",
          "checked": {
            "$bindState": "/alerts/failed"
          }
        },
        "children": []
      }
    },
    "state": {
      "twoFactor": {
        "enabled": true,
        "method": "Authenticator app",
        "sms": false,
        "email": true
      },
      "showDisable": false,
      "alerts": {
        "newLogin": true,
        "failed": true
      },
      "sessions": [
        {
