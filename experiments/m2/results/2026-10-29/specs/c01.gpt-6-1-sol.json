{
  "spec": {
    "root": "catalog",
    "elements": {
      "catalog": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "className": "min-h-screen bg-[#faf8f4] text-[#20271f] p-6 md:p-10"
        },
        "children": [
          "navigation",
          "hero",
          "shop",
          "service",
          "bag"
        ]
      },
      "navigation": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between",
          "gap": "md",
          "className": "border-b border-[#20271f]/20 pb-5"
        },
        "children": [
          "wordmark",
          "nav-note",
          "bag-button"
        ]
      },
      "wordmark": {
        "type": "Heading",
        "props": {
          "text": "schu.",
          "level": "h2"
        },
        "children": []
      },
      "nav-note": {
        "type": "Text",
        "props": {
          "text": "GOOD SHOES. GREAT COMPANY.",
          "variant": "caption"
        },
        "children": []
      },
      "bag-button": {
        "type": "Button",
        "props": {
          "label": "Your bag",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/bagOpen",
              "value": true
            }
          }
        },
        "children": []
      },
      "hero": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "lg",
          "className": "max-md:grid-cols-1 rounded-3xl bg-[#e7eddb] overflow-hidden p-6 md:p-12"
        },
        "children": [
          "hero-copy",
          "hero-image"
        ]
      },
      "hero-copy": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "justify": "center",
          "align": "start",
          "className": "py-6"
        },
        "children": [
          "hero-eyebrow",
          "hero-title",
          "hero-description",
          "hero-price",
          "hero-button",
          "hero-note"
        ]
      },
      "hero-eyebrow": {
        "type": "Badge",
        "props": {
          "text": "MEET OUR ORIGINAL",
          "variant": "outline"
        },
        "children": []
      },
      "hero-title": {
        "type": "Heading",
        "props": {
          "text": "Big on everyday.\nMeet The Schu.",
          "level": "h1"
        },
        "children": []
      },
      "hero-description": {
        "type": "Text",
        "props": {
          "text": "Your daily rotation deserves a new favorite. Our own take on the everyday sneaker: clean lines, easy styling, and a little independent spirit.",
          "variant": "lead"
        },
        "children": []
      },
      "hero-price": {
        "type": "Text",
        "props": {
          "text": "The Schu Original · $95",
          "variant": "body"
        },
        "children": []
      },
      "hero-button": {
        "type": "Button",
        "props": {
          "label": "Discover The Schu →",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/collection",
              "value": "schu"
            }
          }
        },
        "children": []
      },
      "hero-note": {
        "type": "Text",
        "props": {
          "text": "Independent by design. Made for your rotation.",
          "variant": "caption"
        },
        "children": []
      },
      "hero-image": {
        "type": "Image",
        "props": {
          "src": "https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=1100&q=85",
          "alt": "Sneaker editorial showing warm suede textures and a classic low-top silhouette",
          "width": 1000,
          "height": 750
        },
        "children": []
      },
      "shop": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "children": [
          "shop-heading",
          "collection-tabs",
          "products",
          "catalog-note"
        ]
      },
      "shop-heading": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "end",
          "gap": "md"
        },
        "children": [
          "shop-title",
          "shop-description"
        ]
      },
      "shop-title": {
        "type": "Heading",
        "props": {
          "text": "A better daily rotation.",
          "level": "h2"
        },
        "children": []
      },
      "shop-description": {
        "type": "Text",
        "props": {
          "text": "The names you know. Your next favorite, too.",
          "variant": "muted"
        },
        "children": []
      },
      "collection-tabs": {
        "type": "Tabs",
        "props": {
          "tabs": [
            {
              "label": "Shop all",
              "value": "all"
            },
            {
              "label": "The Schu · Our original",
              "value": "schu"
            }
          ],
          "value": {
            "$bindState": "/collection"
          }
        },
        "children": []
      },
      "products": {
        "type": "Grid",
        "props": {
          "columns": 3,
          "gap": "lg",
          "className": "max-md:grid-cols-2 max-sm:grid-cols-1"
        },
        "repeat": {
          "statePath": "/products",
          "key": "id"
        },
        "visible": {
          "$or": [
            {
              "$state": "/collection",
              "eq": "all"
            },
            {
              "$and": [
                {
                  "$state": "/collection",
                  "eq": "schu"
                },
                {
                  "$item": "brand",
                  "eq": "The Schu"
                }
              ]
            }
          ]
        },
        "children": [
          "product"
        ]
      },
      "product": {
        "type": "Card",
        "props": {
          "className": "h-full rounded-2xl border-[#20271f]/10 bg-white shadow-none"
        },
        "children": [
          "product-image",
          "product-content"
        ]
      },
      "product-image": {
        "type": "Image",
        "props": {
          "src": {
            "$item": "image"
          },
          "alt": {
            "$item": "alt"
          },
          "width": 700,
          "height": 500
        },
        "children": []
      },
      "product-content": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md",
          "className": "pt-4"
        },
        "children": [
          "product-tag",
          "product-brand",
          "product-title",
          "product-description",
          "product-price",
          "product-size",
          "product-add"
        ]
      },
      "product-tag": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "tag"
          },
          "variant": {
            "$cond": {
              "$item": "brand",
              "eq": "The Schu"
            },
            "$then": "default",
            "$else": "secondary"
          }
        },
        "children": []
      },
      "product-brand": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "brand"
          },
          "variant": "caption"
        },
        "children": []
      },
      "product-title": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "name"
          },
          "level": "h3"
        },
        "children": []
      },
      "product-description": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "description"
          },
          "variant": "muted"
        },
        "children": []
      },
      "product-price": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "price"
          },
          "variant": "lead"
        },
        "children": []
      },
      "product-size": {
        "type": "Select",
        "props": {
          "label": "Size · US men's",
          "name": {
            "$template": "size-${id}"
          },
          "options": [
            "US 6",
            "US 7",
            "US 8",
            "US 9",
            "US 10",
            "US 11",
            "US 12"
          ],
          "value": {
            "$bindItem": "size"
          },
          "checks": [
            {
              "type": "required",
              "message": "Choose your size."
            }
          ]
        },
        "children": []
      },
      "product-add": {
        "type": "Button",
        "props": {
          "label": "Add to bag +",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "pushState",
            "params": {
              "statePath": "/bag",
              "value": {
                "id": "$id",
                "name": {
                  "$item": "name"
                },
                "brand": {
                  "$item": "brand"
                },
                "price": {
                  "$item": "price"
                },
                "size": {
                  "$item": "size"
                }
              }
            }
          }
        },
        "children": []
      },
      "catalog-note": {
        "type": "Text",
        "props": {
          "text": "Sample catalog · Product photography is illustrative. Prices and sizes shown are for preview.",
          "variant": "caption"
        },
        "children": []
      },
      "service": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md",
          "className": "border-t border-[#20271f]/20 pt-8 pb-4"
        },
        "children": [
          "service-title",
          "service-copy",
          "service-footer"
        ]
      },
      "service-title": {
        "type": "Heading",
        "props": {
          "text": "Small company. Thoughtful selection.",
          "level": "h2"
        },
        "children": []
      },
      "service-copy": {
        "type": "Text",
        "props": {
          "text": "We bring familiar sneaker icons and our own original together in one place. Find a pair that feels like you.",
          "variant": "muted"
        },
        "children": []
      },
      "service-footer": {
        "type": "Text",
        "props": {
          "text": "schu. · Find your everyday.",
          "variant": "caption"
        },
        "children": []
      },
      "bag": {
        "type": "Drawer",
        "props": {
          "title": "Your bag",
          "description": "Your next rotation starts here.",
          "openPath": "/bagOpen"
        },
        "children": [
          "bag-empty",
          "bag-items",
          "bag-note",
          "bag-close"
        ]
      },
      "bag-empty": {
        "type": "Text",
        "props": {
          "text": "Choose a pair and your size, then add it to your bag.",
          "variant": "muted"
        },
        "children": []
      },
      "bag-items": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/bag",
          "key": "id"
        },
        "children": [
          "bag-item"
        ]
      },
      "bag-item": {
        "type": "Card",
        "props": {},
        "children": [
          "bag-item-name",
          "bag-item-details",
          "bag-remove"
        ]
      },
      "bag-item-name": {
        "type": "Heading",
        "props": {
          "text": {
            "$template": "${brand} · ${name}"
          },
          "level": "h4"
        },
        "children": []
      },
      "bag-item-details": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${size} · ${price}"
          },
          "variant": "body"
        },
        "children": []
      },
      "bag-remove": {
        "type": "Button",
        "props": {
          "label": "Remove",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "removeState",
            "params": {
              "statePath": "/bag",
              "index": {
                "$index": true
              }
            }
          }
        },
        "children": []
      },
      "bag-note": {
        "type": "Text",
        "props": {
          "text": "Preview bag only. Checkout is not connected.",
          "variant": "caption"
        },
        "children": []
      },
      "bag-close": {
        "type": "Button",
        "props": {
          "label": "Continue shopping",
          "variant": "primary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/bagOpen",
              "value": false
            }
          }
        },
        "children": []
      }
    },
    "state": {
      "bagOpen": false,
      "collection": "all",
      "products": [
        {
          "id": "schu-chalk",
          "brand": "The Schu",
          "name": "Original · Chalk / Moss",
          "price": "$95",
          "description": "Our signature everyday low-top. A clean start for any outfit.",
          "tag": "OUR ORIGINAL",
          "image": "https://images.unsplash.com/photo-1600269452121-4f2416e55c28?auto=format&fit=crop&w=800&q=85",
          "alt": "White low-top sneaker, illustrative image for The Schu Original",
          "size": "US 9"
        },
        {
          "id": "schu-sand",
          "brand": "The Schu",
          "name": "Original · Sand",
          "price": "$95",
          "description": "An easy neutral with a warm, understated finish.",
          "tag": "OUR ORIGINAL",
          "image": "https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=800&q=85",
          "alt": "Warm neutral sneaker, illustrative image for The Schu Original Sand",
          "size": "US 9"
        },
        {
          "id": "nike-air-force",
          "brand": "Nike",
          "name": "Air Force 1 ’07 · White",
          "price": "$115",
          "description": "The unmistakable court classic. A staple for a reason.",
          "tag": "THE CLASSICS",
          "image": "https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?auto=format&fit=crop&w=800&q=85",
          "alt": "White Nike sneakers",
          "size": "US 9"
        },
        {
          "id": "adidas-samba",
          "brand": "adidas",
          "name": "Samba OG · Black / White",
          "price": "$100",
          "description": "A low-profile icon with roots on the indoor pitch.",
          "tag": "THE CLASSICS",
          "image": "https://images.unsplash.com/photo-1518002171953-a080ee817e1f?auto=format&fit=crop&w=800&q=85",
          "alt": "Sneaker editorial illustrating the adidas selection",
          "size": "US 9"
        },
        {
          "id": "new-balance-574",
          "brand": "New Balance",
          "name": "574 Core · Grey",
          "price": "$90",
          "description": "Retro running character that fits right into everyday life.",
          "tag": "EVERYDAY FAVORITE",
          "image": "https://images.unsplash.com/photo-1539185441755-769473a23570?auto=format&fit=crop&w=800&q=85",
          "alt": "Sneaker editorial illustrating the New Balance selection",
          "size": "US 9"
        }
      ],
      "bag": []
    }
  },
  "patchLines": 54,
  "skippedLines": 0,
  "firstNodeMs": null,
  "issues": [],
  "fixes": []
}
