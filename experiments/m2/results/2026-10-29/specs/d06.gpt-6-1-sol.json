{
  "spec": {
    "root": "dashboard",
    "elements": {
      "dashboard": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "className": "mx-auto max-w-7xl p-6 md:p-10 bg-slate-50"
        },
        "children": [
          "header",
          "metrics",
          "main-grid",
          "insight"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between",
          "gap": "lg",
          "className": "flex-wrap"
        },
        "children": [
          "header-copy",
          "week-badge"
        ]
      },
      "header-copy": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "eyebrow",
          "title",
          "subtitle"
        ]
      },
      "eyebrow": {
        "type": "Text",
        "props": {
          "text": "PACE / YOUR DAILY MOMENTUM",
          "variant": "caption"
        },
        "children": []
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "A little stronger, every day.",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Your activity, recovery, and goals in one place.",
          "variant": "muted"
        },
        "children": []
      },
      "week-badge": {
        "type": "Badge",
        "props": {
          "text": "October 26–November 1, 2026",
          "variant": "outline"
        },
        "children": []
      },
      "metrics": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"
        },
        "repeat": {
          "statePath": "/metrics",
          "key": "id"
        },
        "children": [
          "metric-card"
        ]
      },
      "metric-card": {
        "type": "Card",
        "props": {
          "title": {
            "$item": "label"
          },
          "className": "h-full rounded-2xl"
        },
        "children": [
          "metric-value",
          "metric-detail",
          "metric-progress"
        ]
      },
      "metric-value": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "value"
          },
          "level": "h2"
        },
        "children": []
      },
      "metric-detail": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "detail"
          },
          "variant": "muted"
        },
        "children": []
      },
      "metric-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "progress"
          },
          "max": 100,
          "label": {
            "$item": "target"
          }
        },
        "children": []
      },
      "main-grid": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "lg",
          "className": "grid-cols-1 lg:grid-cols-2"
        },
        "children": [
          "workouts-card",
          "goals-card"
        ]
      },
      "workouts-card": {
        "type": "Card",
        "props": {
          "title": "Your week in motion",
          "description": "Three sessions completed • 112 active minutes",
          "className": "rounded-2xl"
        },
        "children": [
          "workouts-list"
        ]
      },
      "workouts-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "repeat": {
          "statePath": "/workouts",
          "key": "id"
        },
        "children": [
          "workout-row"
        ]
      },
      "workout-row": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm",
          "className": "border-b border-slate-100 pb-4"
        },
        "children": [
          "workout-top",
          "workout-date",
          "workout-detail"
        ]
      },
      "workout-top": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center",
          "gap": "md"
        },
        "children": [
          "workout-name",
          "workout-duration"
        ]
      },
      "workout-name": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "name"
          },
          "level": "h3"
        },
        "children": []
      },
      "workout-duration": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "duration"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "workout-date": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${date} · ${intensity} intensity"
          },
          "variant": "caption"
        },
        "children": []
      },
      "workout-detail": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "detail"
          },
          "variant": "muted"
        },
        "children": []
      },
      "goals-card": {
        "type": "Card",
        "props": {
          "title": "Keep your goals moving",
          "description": "Small milestones. Lasting momentum.",
          "className": "rounded-2xl"
        },
        "children": [
          "goals-list"
        ]
      },
      "goals-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl"
        },
        "repeat": {
          "statePath": "/goals",
          "key": "id"
        },
        "children": [
          "goal-block"
        ]
      },
      "goal-block": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "goal-top",
          "goal-current",
          "goal-progress",
          "goal-next"
        ]
      },
      "goal-top": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center",
          "gap": "md"
        },
        "children": [
          "goal-title",
          "goal-period"
        ]
      },
      "goal-title": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "title"
          },
          "level": "h3"
        },
        "children": []
      },
      "goal-period": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "period"
          },
          "variant": "outline"
        },
        "children": []
      },
      "goal-current": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "current"
          },
          "variant": "body"
        },
        "children": []
      },
      "goal-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "progress"
          },
          "max": 100,
          "label": {
            "$item": "title"
          }
        },
        "children": []
      },
      "goal-next": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "next"
          },
          "variant": "caption"
        },
        "children": []
      },
      "insight": {
        "type": "Alert",
        "props": {
          "title": "Your next small win",
          "message": "You’re 1,568 steps from today’s target. A short walk is a great way to keep your momentum going.",
          "type": "info"
        },
        "children": []
      }
    },
