          "status": "At capacity",
          "tickets": 32,
          "urgent": 3,
          "oldest": "42m",
          "variant": "destructive"
        },
        {
          "id": "priya",
          "name": "Priya Shah",
          "status": "Available",
          "tickets": 26,
          "urgent": 1,
          "oldest": "23m",
          "variant": "secondary"
        },
        {
          "id": "leo",
          "name": "Leo Martinez",
          "status": "In a call",
          "tickets": 28,
          "urgent": 1,
          "oldest": "31m",
          "variant": "outline"
        }
      ],
      "queueFilter": "all",
