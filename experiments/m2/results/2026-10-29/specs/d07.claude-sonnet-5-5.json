{
  "spec": {
    "root": "main",
    "elements": {
      "main": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "children": [
          "header",
          "metrics",
          "mid-grid",
          "bottom-grid"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "header-text",
          "header-badge"
        ]
      },
      "header-text": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/project/name"
          },
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "Phase: ${/project/phase} · Ends ${/project/endDate}"
          },
          "variant": "muted"
        },
        "children": []
      },
      "header-badge": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/project/status"
          },
          "variant": "default"
        },
        "children": []
      },
      "metrics": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md"
        },
        "children": [
          "m1",
          "m2",
          "m3",
          "m4"
        ]
      },
      "m1": {
        "type": "Card",
        "props": {
          "title": "Overall Progress"
        },
        "children": [
          "m1-val",
          "m1-bar"
        ]
      },
      "m1-val": {
        "type": "Heading",
        "props": {
          "text": {
            "$template": "${/project/overall}%"
          },
          "level": "h2"
        },
        "children": []
      },
      "m1-bar": {
        "type": "Progress",
        "props": {
          "value": {
            "$state": "/project/overall"
          },
          "max": 100
        },
        "children": []
      },
      "m2": {
        "type": "Card",
        "props": {
          "title": "Tasks Completed"
        },
        "children": [
          "m2-val",
          "m2-text"
        ]
      },
      "m2-val": {
        "type": "Heading",
        "props": {
          "text": {
            "$template": "${/project/tasksDone} / ${/project/tasksTotal}"
          },
          "level": "h2"
        },
        "children": []
      },
      "m2-text": {
        "type": "Text",
        "props": {
          "text": "Across all workstreams",
          "variant": "muted"
        },
        "children": []
      },
      "m3": {
        "type": "Card",
        "props": {
          "title": "Open Issues"
        },
        "children": [
          "m3-val",
          "m3-text"
        ]
      },
      "m3-val": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/project/openIssues"
          },
          "level": "h2"
        },
        "children": []
      },
      "m3-text": {
        "type": "Text",
        "props": {
          "text": "3 high priority",
          "variant": "muted"
        },
        "children": []
      },
      "m4": {
        "type": "Card",
        "props": {
          "title": "Days Remaining"
        },
        "children": [
          "m4-val",
          "m4-text"
        ]
      },
      "m4-val": {
        "type": "Heading",
        "props": {
          "text": "52",
          "level": "h2"
        },
        "children": []
      },
      "m4-text": {
        "type": "Text",
        "props": {
          "text": "Until final delivery",
          "variant": "muted"
        },
        "children": []
      },
      "mid-grid": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "md"
        },
        "children": [
          "milestones-card",
          "completion-card"
        ]
      },
      "milestones-card": {
        "type": "Card",
        "props": {
          "title": "Milestones",
          "description": "Key project checkpoints"
        },
        "children": [
          "milestone-list"
        ]
      },
      "milestone-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/milestones",
          "key": "id"
        },
        "children": [
          "milestone-item"
        ]
      },
      "milestone-item": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "milestone-row",
          "milestone-bar"
        ]
      },
      "milestone-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "md",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "milestone-name",
          "milestone-meta"
        ]
      },
      "milestone-name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "variant": "body"
        },
        "children": []
      },
      "milestone-meta": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "milestone-date",
          "milestone-status"
        ]
      },
      "milestone-date": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "date"
          },
          "variant": "caption"
        },
        "children": []
      },
      "milestone-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "milestone-bar": {
        "type": "Progress",
        "props": {
          "value": {
            "$item": "progress"
          },
          "max": 100
        },
        "children": []
      },
      "completion-card": {
        "type": "Card",
        "props": {
          "title": "Task Completion",
          "description": "Progress by workstream"
        },
        "children": [
          "completion-list"
        ]
      },
      "completion-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/workstreams",
          "key": "id"
        },
        "children": [
          "ws-item"
        ]
      },
      "ws-item": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "ws-row",
          "ws-bar"
        ]
      },
      "ws-row": {
        "type": "Stack",
