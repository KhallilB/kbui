{
  "spec": {
    "root": "notification-settings",
    "elements": {
      "notification-settings": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "className": "mx-auto w-full max-w-5xl p-6"
        },
        "children": [
          "page-header",
          "preferences-card",
          "delivery-card",
          "settings-note"
        ]
      },
      "page-header": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "page-title",
          "page-description",
          "project-badge"
        ]
      },
      "page-title": {
        "type": "Heading",
        "props": {
          "text": "Notification settings",
          "level": "h1"
        },
        "children": []
      },
      "page-description": {
        "type": "Text",
        "props": {
          "text": "Choose which project updates reach you and where they appear.",
          "variant": "lead"
        },
        "children": []
      },
      "project-badge": {
        "type": "Badge",
        "props": {
          "text": "Applies to your notifications across all projects",
          "variant": "secondary"
        },
        "children": []
      },
      "preferences-card": {
        "type": "Card",
        "props": {
          "title": "Project activity",
          "description": "Enable a channel for each event you want to hear about.",
          "maxWidth": "full"
        },
        "children": [
          "channel-headings",
          "channel-separator",
          "event-list"
        ]
      },
      "channel-headings": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "items-center"
        },
        "children": [
          "event-heading",
          "email-heading",
          "push-heading",
          "in-app-heading"
        ]
      },
      "event-heading": {
        "type": "Text",
        "props": {
          "text": "EVENT",
          "variant": "caption"
        },
        "children": []
      },
      "email-heading": {
        "type": "Text",
        "props": {
          "text": "EMAIL",
          "variant": "caption"
        },
        "children": []
      },
      "push-heading": {
        "type": "Text",
        "props": {
          "text": "PUSH",
          "variant": "caption"
        },
        "children": []
      },
      "in-app-heading": {
        "type": "Text",
        "props": {
          "text": "IN-APP",
          "variant": "caption"
        },
        "children": []
      },
      "channel-separator": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "event-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "className": "py-4"
        },
        "repeat": {
          "statePath": "/events",
          "key": "id"
        },
        "children": [
          "event-row",
          "event-divider"
        ]
      },
      "event-row": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "items-center"
        },
        "children": [
          "event-details",
          "event-email",
          "event-push",
          "event-in-app"
        ]
      },
      "event-details": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "event-title",
          "event-description"
        ]
      },
      "event-title": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "title"
          },
          "level": "h3"
        },
        "children": []
      },
      "event-description": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "description"
          },
          "variant": "muted"
        },
        "children": []
      },
      "event-email": {
        "type": "Switch",
        "props": {
          "label": {
            "$template": "${title}: email"
          },
          "name": {
            "$template": "${id}-email"
          },
          "checked": {
            "$bindItem": "email"
          }
        },
        "children": []
      },
      "event-push": {
        "type": "Switch",
        "props": {
          "label": {
            "$template": "${title}: push"
          },
          "name": {
            "$template": "${id}-push"
          },
          "checked": {
            "$bindItem": "push"
          }
        },
        "children": []
      },
      "event-in-app": {
        "type": "Switch",
        "props": {
          "label": {
            "$template": "${title}: in-app"
          },
          "name": {
            "$template": "${id}-in-app"
          },
          "checked": {
            "$bindItem": "inApp"
          }
        },
        "children": []
      },
      "event-divider": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "delivery-card": {
        "type": "Card",
        "props": {
          "title": "Email delivery",
          "description": "Choose when enabled email notifications arrive.",
          "maxWidth": "full"
        },
        "children": [
          "email-frequency",
          "delivery-note",
          "push-note"
        ]
      },
      "email-frequency": {
        "type": "Select",
        "props": {
          "label": "Email frequency",
          "name": "email-frequency",
          "options": [
            "Immediately",
            "Hourly digest",
            "Daily digest"
          ],
          "value": {
            "$bindState": "/emailFrequency"
          },
          "checks": [
            {
              "type": "required",
              "message": "Choose an email frequency."
            }
          ]
        },
        "children": []
      },
      "delivery-note": {
        "type": "Text",
        "props": {
          "text": "Digests group enabled email events into one message. Push and in-app notifications arrive as activity happens.",
          "variant": "muted"
        },
        "children": []
      },
      "push-note": {
        "type": "Text",
        "props": {
          "text": "Push notifications also require notification permission on your device or browser.",
          "variant": "caption"
        },
        "children": []
      },
      "settings-note": {
        "type": "Text",
        "props": {
          "text": "These preferences control project activity notifications. Account security and billing messages are managed separately.",
          "variant": "caption"
        },
        "children": []
      }
    },
    "state": {
      "events": [
        {
          "id": "assignments",
          "title": "Task assignments",
          "description": "A task is assigned or reassigned to you.",
          "email": true,
          "push": true,
          "inApp": true
        },
        {
          "id": "mentions",
          "title": "Mentions and replies",
          "description": "Someone mentions you or replies to your comment.",
          "email": true,
          "push": true,
          "inApp": true
        },
        {
          "id": "deadlines",
          "title": "Due date reminders",
          "description": "Your tasks are due soon or overdue.",
          "email": true,
          "push": false,
          "inApp": true
        },
        {
          "id": "status",
          "title": "Task status changes",
          "description": "A task you follow moves to a new status.",
          "email": false,
          "push": false,
          "inApp": true
        },
        {
          "id": "project-updates",
          "title": "Project updates",
          "description": "New milestones and announcements in projects you follow.",
          "email": true,
          "push": false,
          "inApp": true
        }
      ],
      "emailFrequency": "Immediately"
    }
  },
  "patchLines": 35,
  "skippedLines": 0,
  "firstNodeMs": null,
  "issues": [],
  "fixes": []
}
