{
  "spec": {
    "root": "dashboard",
    "elements": {
      "dashboard": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "className": "mx-auto max-w-7xl p-6 lg:p-10 bg-slate-50 text-slate-900"
        },
        "children": [
          "header",
          "metrics",
          "stock-overview",
          "operations",
          "catalog"
        ]
      },
      "header": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between",
          "gap": "lg",
          "className": "flex-wrap"
        },
        "children": [
          "header-copy",
          "warehouse-badge"
        ]
      },
      "header-copy": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "eyebrow",
          "title",
          "subtitle"
        ]
      },
      "eyebrow": {
        "type": "Text",
        "props": {
          "text": "OPERATIONS / INVENTORY",
          "variant": "caption"
        },
        "children": []
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Warehouse overview",
          "level": "h1"
        },
        "children": []
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Stock on hand, replenishment priorities, and inbound deliveries.",
          "variant": "muted"
        },
        "children": []
      },
      "warehouse-badge": {
        "type": "Badge",
        "props": {
          "text": "WH-01 · Oakland",
          "variant": "outline"
        },
        "children": []
      },
      "metrics": {
        "type": "Grid",
        "props": {
          "columns": 4,
          "gap": "md",
          "className": "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"
        },
        "repeat": {
          "statePath": "/metrics",
          "key": "id"
        },
        "children": [
          "metric-card"
        ]
      },
      "metric-card": {
        "type": "Card",
        "props": {
          "className": "border-slate-200 bg-white"
        },
        "children": [
          "metric-label",
          "metric-value",
          "metric-detail"
        ]
      },
      "metric-label": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "label"
          },
          "variant": "muted"
        },
        "children": []
      },
      "metric-value": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "value"
          },
          "level": "h2"
        },
        "children": []
      },
      "metric-detail": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "detail"
          },
          "variant": "caption"
        },
        "children": []
      },
      "stock-overview": {
        "type": "Card",
        "props": {
          "title": "Stock health",
          "description": "Products above their reorder point",
          "className": "border-slate-200 bg-white"
        },
        "children": [
          "health-progress",
          "health-note"
        ]
      },
      "health-progress": {
        "type": "Progress",
        "props": {
          "value": {
            "$state": "/stockHealth"
          },
          "max": 100,
          "label": "85% healthy · 34 products"
        },
        "children": []
      },
      "health-note": {
        "type": "Text",
        "props": {
          "text": "6 products need replenishment. All products currently have stock available.",
          "variant": "muted"
        },
        "children": []
      },
      "operations": {
        "type": "Grid",
        "props": {
          "columns": 2,
          "gap": "lg",
          "className": "grid-cols-1 lg:grid-cols-2"
        },
        "children": [
          "low-stock",
          "incoming"
        ]
      },
      "low-stock": {
        "type": "Card",
        "props": {
          "title": "Replenishment priorities",
          "description": "6 products at or below their reorder point",
          "className": "border-amber-200 bg-white"
        },
        "children": [
          "low-alert",
          "low-list"
        ]
      },
      "low-alert": {
        "type": "Alert",
        "props": {
          "title": "Reorder attention needed",
          "message": "Review available units against each product’s reorder point.",
          "type": "warning"
        },
        "children": []
      },
      "low-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": "/products",
          "key": "id"
        },
        "visible": {
          "$item": "low",
          "eq": true
        },
        "children": [
          "low-row"
        ]
      },
      "low-row": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center",
          "gap": "md",
          "className": "border-b border-slate-100 py-3"
        },
        "children": [
          "low-copy",
          "low-quantity"
        ]
      },
      "low-copy": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "low-name",
          "low-sku"
        ]
      },
      "low-name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          }
        },
        "children": []
      },
      "low-sku": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${sku} · Bin ${location}"
          },
          "variant": "caption"
        },
        "children": []
      },
      "low-quantity": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "align": "end",
          "gap": "sm"
        },
        "children": [
          "low-badge",
          "low-threshold"
        ]
      },
      "low-badge": {
        "type": "Badge",
        "props": {
          "text": {
            "$template": "${stock} available"
          },
          "variant": "destructive"
        },
        "children": []
      },
      "low-threshold": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "Reorder at ${reorder}"
          },
          "variant": "caption"
        },
        "children": []
      },
      "incoming": {
        "type": "Card",
        "props": {
          "title": "Incoming shipments",
          "description": "3 deliveries · 1,440 units on the way",
          "className": "border-slate-200 bg-white"
        },
        "children": [
          "shipment-list",
          "shipment-note"
        ]
      },
      "shipment-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg"
        },
        "repeat": {
          "statePath": "/shipments",
          "key": "id"
        },
        "children": [
          "shipment-card"
        ]
      },
      "shipment-card": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm",
          "className": "rounded-lg border border-slate-200 p-4"
        },
        "children": [
          "shipment-top",
          "shipment-supplier",
          "shipment-contents",
          "shipment-eta",
          "shipment-meta"
        ]
      },
      "shipment-top": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "justify": "between",
          "align": "center",
          "gap": "md"
        },
        "children": [
          "shipment-id",
          "shipment-status"
        ]
      },
      "shipment-id": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "id"
          },
          "variant": "code"
        },
        "children": []
      },
      "shipment-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": {
            "$item": "variant"
          }
        },
        "children": []
      },
      "shipment-supplier": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "supplier"
          },
          "level": "h3"
        },
        "children": []
      },
      "shipment-contents": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "contents"
          },
          "variant": "muted"
        },
        "children": []
      },
      "shipment-eta": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "Expected ${eta}"
          }
        },
        "children": []
      },
      "shipment-meta": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${quantity} units · ${dock} · ${po}"
          },
          "variant": "caption"
        },
        "children": []
      },
      "shipment-note": {
        "type": "Text",
        "props": {
          "text": "Expected units are excluded from available stock until received. Delivery times are Pacific Time.",
          "variant": "caption"
        },
        "children": []
      },
      "catalog": {
        "type": "Card",
        "props": {
          "title": "Full product inventory",
          "description": "40 products · Available stock excludes incoming shipments",
          "className": "border-slate-200 bg-white"
        },
        "children": [
          "catalog-controls",
          "catalog-header",
          "product-list",
          "catalog-footer"
        ]
      },
      "catalog-controls": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between",
          "gap": "md",
          "className": "flex-wrap pb-4"
        },
        "children": [
          "stock-filter",
          "units-note"
        ]
      },
      "stock-filter": {
        "type": "ToggleGroup",
        "props": {
          "items": [
            {
              "label": "All products",
              "value": "all"
            },
            {
              "label": "Low stock",
              "value": "low"
            },
            {
              "label": "Healthy",
              "value": "healthy"
            }
          ],
          "type": "single",
          "value": {
            "$bindState": "/stockFilter"
          }
        },
        "children": []
      },
      "units-note": {
        "type": "Text",
        "props": {
          "text": "Quantities use each product’s listed unit or pack.",
          "variant": "caption"
        },
        "children": []
      },
      "catalog-header": {
        "type": "Grid",
        "props": {
          "columns": 6,
          "gap": "md",
          "className": "hidden md:grid border-y border-slate-200 bg-slate-50 px-4 py-3"
        },
        "children": [
          "col-product",
          "col-category",
          "col-bin",
          "col-stock",
          "col-reorder",
          "col-status"
        ]
      },
      "col-product": {
        "type": "Text",
        "props": {
          "text": "PRODUCT / SKU",
          "variant": "caption"
        },
        "children": []
      },
      "col-category": {
        "type": "Text",
        "props": {
          "text": "CATEGORY",
          "variant": "caption"
        },
        "children": []
      },
      "col-bin": {
        "type": "Text",
        "props": {
          "text": "BIN LOCATION",
          "variant": "caption"
        },
        "children": []
      },
      "col-stock": {
        "type": "Text",
        "props": {
          "text": "AVAILABLE",
          "variant": "caption"
        },
        "children": []
      },
      "col-reorder": {
        "type": "Text",
        "props": {
          "text": "REORDER POINT",
          "variant": "caption"
        },
        "children": []
      },
      "col-status": {
        "type": "Text",
        "props": {
          "text": "STATUS",
          "variant": "caption"
        },
        "children": []
      },
      "product-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "none"
        },
        "repeat": {
          "statePath": "/products",
          "key": "id"
        },
        "children": [
          "product-row"
        ]
      },
      "product-row": {
        "type": "Grid",
        "props": {
          "columns": 6,
          "gap": "md",
          "className": "grid-cols-2 md:grid-cols-6 items-center border-b border-slate-100 px-4 py-4"
        },
        "visible": {
          "$or": [
            {
              "$state": "/stockFilter",
              "eq": "all"
            },
            {
              "$state": "/stockFilter",
              "not": true
            },
            {
              "$and": [
                {
                  "$state": "/stockFilter",
                  "eq": "low"
                },
                {
                  "$item": "low",
                  "eq": true
                }
              ]
            },
            {
              "$and": [
                {
                  "$state": "/stockFilter",
                  "eq": "healthy"
                },
                {
                  "$item": "low",
                  "eq": false
                }
              ]
            }
          ]
        },
        "children": [
          "product-identity",
          "product-category",
          "product-bin",
          "product-stock",
          "product-reorder",
          "product-status"
        ]
      },
      "product-identity": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "product-name",
          "product-sku"
        ]
      },
      "product-name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          }
        },
        "children": []
      },
      "product-sku": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "sku"
          },
          "variant": "caption"
        },
        "children": []
      },
      "product-category": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "category"
          },
          "variant": "muted"
        },
        "children": []
      },
      "product-bin": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "location"
          },
          "variant": "code"
        },
        "children": []
      },
      "product-stock": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "${stock} available"
          }
        },
        "children": []
      },
      "product-reorder": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "Reorder at ${reorder}"
          },
          "variant": "muted"
        },
        "children": []
      },
      "product-status": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "variant": {
            "$item": "variant"
          }
        },
        "children": []
      }
    },
