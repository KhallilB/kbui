            }
          ]
        },
        {
          "id": "pro",
          "name": "Pro",
          "description": "Your whole world, beautifully connected.",
          "monthlyPrice": "$10",
          "annualPrice": "$8",
          "monthlyNote": "$10 billed monthly. For one person.",
          "annualNote": "$96 billed yearly. For one person.",
