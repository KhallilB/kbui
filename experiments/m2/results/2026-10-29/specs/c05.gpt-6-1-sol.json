{
  "spec": {
    "root": "pricing-page",
    "elements": {
      "pricing-page": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "xl",
          "className": "mx-auto max-w-6xl px-6 py-10 text-slate-900"
        },
        "children": [
          "navigation",
          "hero",
          "billing-controls",
          "plans",
          "reassurance",
          "faq",
          "signup"
        ]
      },
      "navigation": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "brand",
          "login"
        ]
      },
      "brand": {
        "type": "Heading",
        "props": {
          "text": "folio.",
          "level": "h3"
        },
        "children": []
      },
      "login": {
        "type": "Link",
        "props": {
          "label": "Explore the plans ↓",
          "href": "#plans"
        },
        "children": []
      },
      "hero": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md",
          "align": "center",
          "className": "pt-12 text-center"
        },
        "children": [
          "eyebrow",
          "headline",
          "intro"
        ]
      },
      "eyebrow": {
        "type": "Badge",
        "props": {
          "text": "A little space. A lot of possibility.",
          "variant": "secondary"
        },
        "children": []
      },
      "headline": {
        "type": "Heading",
        "props": {
          "text": "Good ideas deserve room to grow.",
          "level": "h1"
        },
        "children": []
      },
      "intro": {
        "type": "Text",
        "props": {
          "text": "Start a daily habit for free. Choose Pro when your notes become your second brain.",
          "variant": "lead"
        },
        "children": []
      },
      "billing-controls": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "billing-toggle",
          "billing-explanation"
        ]
      },
      "billing-toggle": {
        "type": "ToggleGroup",
        "props": {
          "items": [
            {
              "label": "Monthly",
              "value": "monthly"
            },
            {
              "label": "Yearly · save 20%",
              "value": "annual"
            }
          ],
          "type": "single",
          "value": {
            "$bindState": "/billing"
          }
        },
        "children": []
      },
      "billing-explanation": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": {
              "$state": "/billing",
              "eq": "annual"
            },
            "$then": "Yearly billing selected. Prices below are per month, paid annually.",
            "$else": "Monthly billing selected. Prices below are paid each month."
          },
          "variant": "caption"
        },
        "children": []
      },
      "plans": {
        "type": "Grid",
        "props": {
          "columns": 3,
          "gap": "lg",
          "className": "items-stretch scroll-mt-8"
        },
        "repeat": {
          "statePath": "/plans",
          "key": "id"
        },
        "children": [
          "plan-card"
        ]
      },
      "plan-card": {
        "type": "Card",
        "props": {
          "maxWidth": "full",
          "className": {
            "$cond": {
              "$item": "featured",
              "eq": true
            },
            "$then": "h-full rounded-2xl border-2 border-indigo-600 bg-indigo-50 p-7 shadow-xl shadow-indigo-100",
            "$else": "h-full rounded-2xl border border-slate-200 bg-white p-7"
          }
        },
        "children": [
          "plan-content"
        ]
      },
      "plan-content": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "className": "h-full"
        },
        "children": [
          "pro-badge",
          "plan-heading",
          "plan-description",
          "price-block",
          "plan-cta",
          "plan-audience",
          "plan-separator",
          "feature-list"
        ]
      },
      "pro-badge": {
        "type": "Badge",
        "props": {
          "text": "THE PERSONAL UPGRADE",
          "variant": "default"
        },
        "visible": {
          "$item": "featured",
          "eq": true
        },
        "children": []
      },
      "plan-heading": {
        "type": "Heading",
        "props": {
          "text": {
            "$item": "name"
          },
          "level": "h2"
        },
        "children": []
      },
      "plan-description": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "description"
          },
          "variant": "muted"
        },
        "children": []
      },
      "price-block": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm"
        },
        "children": [
          "price-line",
          "billing-note"
        ]
      },
      "price-line": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "sm",
          "align": "end"
        },
        "children": [
          "plan-price",
          "price-unit"
        ]
      },
      "plan-price": {
        "type": "Heading",
        "props": {
          "text": {
            "$cond": {
              "$state": "/billing",
              "eq": "annual"
            },
            "$then": {
              "$item": "annualPrice"
            },
            "$else": {
              "$item": "monthlyPrice"
            }
          },
          "level": "h1"
        },
        "children": []
      },
      "price-unit": {
        "type": "Text",
        "props": {
          "text": "/ month",
          "variant": "muted"
        },
        "children": []
      },
      "billing-note": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": {
              "$state": "/billing",
              "eq": "annual"
            },
            "$then": {
              "$item": "annualNote"
            },
            "$else": {
              "$item": "monthlyNote"
            }
          },
          "variant": "caption"
        },
        "children": []
      },
      "plan-cta": {
        "type": "Button",
        "props": {
          "label": {
            "$item": "cta"
          },
          "variant": {
            "$cond": {
              "$item": "featured",
              "eq": true
            },
            "$then": "primary",
            "$else": "secondary"
          }
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/selectedPlan",
              "value": {
                "$item": "name"
              }
            }
          }
        },
        "children": []
      },
      "plan-audience": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "audience"
          },
          "variant": "caption"
        },
        "children": []
      },
      "plan-separator": {
        "type": "Separator",
        "props": {
          "orientation": "horizontal"
        },
        "children": []
      },
      "feature-list": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "repeat": {
          "statePath": {
            "$item": "features"
          },
          "key": "id"
        },
        "children": [
          "feature-text"
        ]
      },
      "feature-text": {
        "type": "Text",
        "props": {
          "text": {
            "$template": "✓ ${text}"
          },
          "variant": "body"
        },
        "children": []
      },
      "reassurance": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "sm",
          "align": "center",
          "className": "text-center"
        },
        "children": [
          "ownership",
          "upgrade-note"
        ]
      },
      "ownership": {
        "type": "Text",
        "props": {
          "text": "Your thoughts stay yours. Every plan includes Markdown export.",
          "variant": "body"
        },
        "children": []
      },
      "upgrade-note": {
        "type": "Text",
        "props": {
          "text": "Start free and upgrade whenever you need more room.",
          "variant": "muted"
        },
        "children": []
      },
      "faq": {
        "type": "Stack",
        "props": {
          "direction": "vertical",
          "gap": "lg",
          "className": "mx-auto w-full max-w-3xl py-8"
        },
        "children": [
          "faq-heading",
          "faq-items"
        ]
      },
      "faq-heading": {
        "type": "Heading",
        "props": {
          "text": "A few things you might be wondering",
          "level": "h2"
        },
        "children": []
      },
      "faq-items": {
        "type": "Accordion",
        "props": {
          "type": "single",
          "items": [
            {
              "title": "Who is Pro best for?",
              "content": "Choose Pro if you use notes for research, projects, or a growing personal knowledge library. It removes the note and device limits, adds backlinks, and gives you 90 days of version history."
            },
            {
              "title": "Do I need Team for my own projects?",
              "content": "Pro includes the complete personal note-taking toolkit. Team adds shared workspaces, member permissions, centralized billing, and priority support for people working together."
            },
            {
              "title": "How does yearly billing work?",
              "content": "Yearly Pro costs $96 per year. Yearly Team costs $144 per member per year. Both are 20% less than paying monthly for 12 months."
            },
            {
              "title": "Can I take my notes with me?",
              "content": "Yes. Every plan includes Markdown export, so you can keep a portable copy of your writing."
            }
          ]
        },
        "children": []
      },
      "signup": {
        "type": "Card",
        "props": {
          "title": {
            "$template": "Your choice: ${/selectedPlan}"
          },
          "description": "Review your selection before creating your workspace.",
          "maxWidth": "md",
          "centered": true,
          "className": "border-indigo-200 bg-indigo-50"
        },
        "visible": {
          "$state": "/selectedPlan"
        },
        "children": [
          "selection-billing",
          "selection-next",
          "selection-close"
        ]
      },
      "selection-next": {
        "type": "Text",
        "props": {
          "text": "This preview saves your plan selection. Account creation and checkout are not connected.",
          "variant": "caption"
        },
        "children": []
      },
      "selection-close": {
        "type": "Button",
        "props": {
          "label": "Keep comparing",
          "variant": "secondary"
        },
        "on": {
          "press": {
            "action": "setState",
            "params": {
              "statePath": "/selectedPlan",
              "value": ""
            }
          }
        },
        "children": []
      }
    },
    "state": {
      "billing": "annual",
      "plans": [
        {
          "id": "free",
