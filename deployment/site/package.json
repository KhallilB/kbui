{
  "name": "kbui-site-deployment",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "build": "cf build --mode production",
    "check": "cf deploy --prebuilt --mode production --dry-run",
    "deploy": "cf deploy --prebuilt --mode production",
    "build:preview": "cf build --mode preview",
    "deploy:preview": "cf deploy --prebuilt --mode preview",
    "test": "node --test config.test.mjs"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.21",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "zod": "4.6.6",
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
