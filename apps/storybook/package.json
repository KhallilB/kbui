{
  "name": "@kb.ui/storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --quiet --disable-telemetry",
    "test": "KBUI_STORYBOOK_INTERNAL=1 vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:site": "vite --config vite.site.config.ts --host 127.0.0.1 --port 4173",
    "build:site": "bun catalog/verify-code.ts && vite build --config vite.site.config.ts && storybook build --quiet --disable-telemetry --output-dir dist/storybook && bun catalog/verify.ts",
    "test:site": "KBUI_STORYBOOK_INTERNAL=1 vitest run --config vitest.site.config.ts stories/Home.stories.tsx stories/Workbench.stories.tsx stories/PlanDemo.stories.tsx stories/Recipes.stories.tsx stories/Changelog.stories.tsx stories/Catalog.stories.tsx stories/CatalogDetails.stories.tsx stories/Setup.stories.tsx stories/SkinComparison.stories.tsx --maxWorkers=2",
    "preview:site": "vite preview --config vite.site.config.ts --host 127.0.0.1 --port 4174 --strictPort",
    "verify:catalog": "bun catalog/verify.ts",
    "verify:adoption": "bun catalog/verify-adoption.ts",
    "verify:storybook": "bun catalog/verify-storybook.ts",
    "verify:component-docs": "bun catalog/verify-component-docs.ts",
    "verify:previews": "node --experimental-strip-types catalog/verify-previews.ts",
    "verify:release": "node --experimental-strip-types catalog/verify-release.ts",
    "verify:controls": "node --experimental-strip-types catalog/verify-control-edges.ts",
    "verify:code": "bun catalog/verify-code.ts",
    "test:a11y": "KBUI_STORYBOOK_INTERNAL=1 vitest run --config vitest.accessibility.config.ts stories/Accessibility.stories.tsx",
    "test:themes": "vitest run --config vitest.themes.config.ts ../../packages/react/src/components",
    "verify:theme": "bun catalog/verify-theme.ts",
    "verify:overrides": "bun catalog/verify-overrides.ts",
    "verify:depth": "bun catalog/verify-depth.ts",
    "dev:internal": "KBUI_STORYBOOK_INTERNAL=1 storybook dev -p 6008 --no-open --disable-telemetry",
    "build:internal": "KBUI_STORYBOOK_INTERNAL=1 storybook build --quiet --disable-telemetry",
    "test:overlays": "KBUI_STORYBOOK_INTERNAL=1 vitest run --config vitest.overlays.config.ts ../../packages/react/src/components/Accordion/Accordion.stories.tsx ../../packages/react/src/components/Disclosure/Disclosure.stories.tsx ../../packages/react/src/components/Dialog/Dialog.stories.tsx ../../packages/react/src/components/Popover/Popover.stories.tsx stories/OverlayCompatibility.stories.tsx",
    "verify:recipes": "node --experimental-strip-types catalog/verify-recipes.ts"
  },
  "dependencies": {
    "@kb.ui/css": "workspace:*",
    "@kb.ui/react": "workspace:*",
    "@kb.ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.0",
    "@base-ui/react": "1.9.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/babel__standalone": "7.1.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "4.14.0",
    "markdown-to-jsx": "9.10.4",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "4.5.0",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
